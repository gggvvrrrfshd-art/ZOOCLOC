      </div>
      <div class="rounded-2xl p-8 sm:p-12 bg-slate-900/90 border border-white/10 text-center space-y-3 shadow-xl">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-sky-500/15 border border-sky-400/30 flex items-center justify-center text-3xl">
