      </div>
    </section>

    <!-- SECTION: CHAT -->
    <section id="view-chat" class="hidden space-y-4 animate-slide-up">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h1 class="text-2xl font-extrabold tracking-tight text-white">Игровой чат</h1>
          <p class="text-sm text-slate-400 mt-0.5">Общайся с игроками ZOOCLOC • Запрещённые слова автоматически заменяются на добрые</p>
        </div>
        <span class="shrink-0 px-2.5 py-1 rounded-full bg-emerald-500/15 border border-emerald-400/30 text-emerald-300 text-xs font-bold flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span id="chat-online-count">4 в чате</span>
        </span>
      </div>

      <div id="chat-mute-banner" class="hidden rounded-2xl p-3.5 bg-rose-500/15 border border-rose-400/40 text-rose-200 text-xs font-bold flex items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <i data-lucide="volume-x" class="w-4 h-4 text-rose-400 shrink-0"></i>
          <span>Вам выдан мут! Осталось: <strong id="chat-mute-timer" class="tabular-nums">10:00</strong></span>
        </div>
      </div>

      <div id="chat-messages" class="rounded-2xl p-4 bg-slate-900/90 border border-white/10 h-[360px] sm:h-[400px] overflow-y-auto space-y-3"></div>

      <form id="chat-form" class="flex gap-2">
        <input id="chat-input" type="text" maxlength="180" placeholder="Напиши сообщение в чат..." class="flex-1 px-4 py-3 rounded-xl bg-slate-900 border border-white/15 text-white text-sm focus:outline-none focus:border-sky-400 transition-colors" />
        <button id="chat-send-btn" type="submit" class="px-5 py-3 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-extrabold text-sm flex items-center gap-1.5 transition-colors shrink-0">
          <i data-lucide="send" class="w-4 h-4"></i>
          <span class="hidden sm:inline">Отправить</span>
        </button>
      </form>
    </section>

    <!-- SECTION: PROFILE -->
    <section id="view-profile" class="hidden space-y-5 animate-slide-up">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h1 class="text-2xl font-extrabold tracking-tight text-white">Профиль</h1>
          <p class="text-sm text-slate-400 mt-0.5">Настрой свою аватарку, юзернейм и описание</p>
        </div>
        <span class="px-2.5 py-1 rounded-full bg-slate-800 border border-white/10 text-[11px] font-semibold text-slate-300 flex items-center gap-1">
          <i data-lucide="lock" class="w-3 h-3 text-emerald-400"></i>
          <span>Защита от копирования</span>
        </span>
      </div>

      <div id="profile-card-protected" class="no-copy rounded-2xl p-5 bg-slate-900/90 border border-white/10 flex flex-col sm:flex-row items-center sm:items-start gap-4">
        <div id="profile-preview-avatar" class="w-20 h-20 rounded-2xl bg-slate-800 border-2 border-sky-400/50 flex items-center justify-center text-4xl overflow-hidden shrink-0">🏎️</div>
        <div class="flex-1 text-center sm:text-left min-w-0">
