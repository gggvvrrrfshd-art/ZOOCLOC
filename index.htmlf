          </button>
          <label for="import-save-input" class="cursor-pointer px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-white/15 text-slate-200 text-xs font-bold flex items-center gap-1.5 transition-colors">
            <i data-lucide="upload" class="w-3.5 h-3.5"></i>
            <span>Загрузить сохранение</span>
            <input id="import-save-input" type="file" accept=".json,application/json" class="hidden" />
          </label>
        </div>
      </div>
