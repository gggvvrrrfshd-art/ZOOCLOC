              <span class="px-2.5 py-1 rounded-xl bg-amber-500/15 border border-amber-400/30">4500 🪙</span>
            </div>
            <button id="buy-admin-btn" type="button" class="px-5 py-2.5 rounded-xl bg-rose-500 hover:bg-rose-400 text-white font-extrabold text-sm transition-colors shadow-lg shadow-rose-500/25">
              Купить за 4500 🪙
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION: AVATAR -->
