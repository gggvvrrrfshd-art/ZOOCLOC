<!DOCTYPE html>
<html lang="ru" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>ZOOCLOC — Игры, Награды и Друзья</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://unpkg.com/lucide@0.460.0/dist/umd/lucide.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    .hidden { display: none !important; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: #0b0f19;
      color: #f1f5f9;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }
    .glass {
      background: rgba(17, 24, 39, 0.85);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .no-copy {
      user-select: none;
      -webkit-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      -webkit-touch-callout: none;
    }
    .card-gradient-1 { background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #4338ca 100%); }
    .card-gradient-2 { background: linear-gradient(135deg, #064e3b 0%, #047857 50%, #059669 100%); }
    .card-gradient-3 { background: linear-gradient(135deg, #4c1d95 0%, #6d28d9 50%, #7c3aed 100%); }
    .card-gradient-4 { background: linear-gradient(135deg, #831843 0%, #be185d 50%, #db2777 100%); }
    .card-gradient-5 { background: linear-gradient(135deg, #78350f 0%, #b45309 50%, #d97706 100%); }
    .coin-glow { box-shadow: 0 0 18px rgba(250, 204, 21, 0.25); }
    .nav-active { color: #38bdf8; }
    .nav-active .nav-pill { background: rgba(56, 189, 248, 0.14); }
    canvas { touch-action: none; display: block; }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-slide-up { animation: slideUp 0.24s ease-out forwards; }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-[#0b0f19] text-slate-100">

  <!-- Loading Screen on Entry -->
  <div id="loading-screen" class="fixed inset-0 z-[100] bg-[#0b0f19] flex flex-col items-center justify-center p-6 transition-opacity duration-500">
    <div class="w-full max-w-xs text-center space-y-5">
      <div class="w-20 h-20 mx-auto rounded-3xl bg-gradient-to-br from-sky-500 to-indigo-600 flex items-center justify-center text-4xl shadow-2xl shadow-sky-500/30 animate-pulse">
        🏁
      </div>
      <div>
        <div class="text-2xl font-extrabold tracking-widest text-white uppercase">ZOOCLOC</div>
        <div id="loading-status-text" class="text-xs text-sky-300 font-semibold mt-1.5">Загрузка профиля и сохранений...</div>
      </div>
      <div class="w-full h-2.5 rounded-full bg-slate-900 border border-white/10 overflow-hidden">
        <div id="loading-progress-bar" class="h-full bg-gradient-to-r from-sky-400 to-emerald-400 transition-all duration-300" style="width: 15%;"></div>
      </div>
      <div id="loading-summary-pill" class="text-[11px] text-slate-400">Восстанавливаем баланс, уровни и достижения...</div>
    </div>
  </div>

  <!-- Top Header -->
  <header class="sticky top-0 z-30 glass border-b border-white/10">
    <div class="max-w-3xl mx-auto px-4 h-16 flex items-center justify-between gap-3">
      <div class="flex items-center gap-3 min-w-0 no-copy">
        <button id="header-profile-btn" type="button" class="flex items-center gap-2.5 text-left group focus:outline-none min-w-0">
          <div id="header-avatar" class="w-10 h-10 rounded-full bg-slate-800 border border-sky-400/40 flex items-center justify-center text-xl overflow-hidden shrink-0 group-hover:scale-105 transition-transform">
            🏎️
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-1.5">
              <span id="header-username" class="text-sm font-bold text-white truncate">Гонщик_01</span>
              <span id="header-admin-badge" class="hidden px-1.5 py-0.5 rounded-md bg-rose-500/20 border border-rose-400/40 text-[10px] font-extrabold text-rose-300 shrink-0">👑 АДМИН</span>
            </div>
            <div class="text-[11px] text-slate-400 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span>
              <span>В сети</span>
            </div>
          </div>
        </button>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button id="admin-header-btn" type="button" class="hidden px-2.5 py-1.5 rounded-xl bg-rose-500/20 hover:bg-rose-500/30 border border-rose-400/40 text-rose-200 text-xs font-bold flex items-center gap-1 transition-colors">
          <i data-lucide="shield" class="w-3.5 h-3.5"></i>
          <span>Админ</span>
        </button>
        <button id="sound-toggle-btn" type="button" title="Звук" class="p-2 rounded-xl bg-slate-800/80 hover:bg-slate-700/80 border border-white/10 text-slate-300 transition-colors">
          <i data-lucide="volume-2" class="w-4 h-4"></i>
        </button>
        <div id="balance-badge" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-500/15 border border-amber-400/30 coin-glow">
          <span class="text-base leading-none">🪙</span>
          <span id="balance-value" class="text-sm font-extrabold text-amber-300 tabular-nums">0</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1 max-w-3xl w-full mx-auto px-4 pt-5 pb-28">

    <!-- SECTION: GAMES LIST -->
    <section id="view-games" class="space-y-5 animate-slide-up">
      <div class="flex items-center justify-between gap-3">
        <div>
          <div class="flex items-center gap-2">
            <span id="brand-title-badge" class="px-2.5 py-0.5 rounded-lg bg-sky-500/20 border border-sky-400/30 text-[11px] font-extrabold tracking-widest text-sky-300 uppercase">ZOOCLOC</span>
          </div>
          <h1 class="text-2xl font-extrabold tracking-tight text-white mt-1">Список игр</h1>
          <p class="text-sm text-slate-400 mt-0.5">Выбери игру и сделай заезд, чтобы получать монетки</p>
        </div>
        <button id="quick-rewards-pill" type="button" class="shrink-0 px-3 py-1.5 rounded-full bg-sky-500/15 border border-sky-400/30 text-sky-300 text-xs font-semibold flex items-center gap-1.5 hover:bg-sky-500/25 transition-colors">
          <i data-lucide="gift" class="w-3.5 h-3.5"></i>
          <span>Заезды: <strong id="mini-runs-count">0</strong>/3</span>
        </button>
      </div>

      <!-- Beta Version Warning Banner -->
      <div id="beta-warning-banner" class="rounded-2xl p-3.5 bg-amber-500/15 border border-amber-400/40 flex items-center gap-3">
        <span class="text-xl shrink-0">🚀</span>
        <div class="text-xs sm:text-sm font-extrabold text-amber-200 tracking-wide">
          основная версия игры выйдет 1 декабря
        </div>
      </div>

      <!-- Custom Admin Main Screen Text Banner -->
      <div id="home-announcement-banner" class="hidden rounded-2xl p-4 bg-gradient-to-r from-sky-500/15 via-indigo-500/15 to-purple-500/15 border border-sky-400/30">
        <div class="flex items-start gap-3">
          <span class="text-xl shrink-0">📢</span>
          <div class="min-w-0">
            <h2 id="home-announcement-title" class="text-sm font-extrabold text-white"></h2>
            <p id="home-announcement-body" class="text-xs text-slate-300 mt-0.5"></p>
          </div>
        </div>
      </div>

      <div id="games-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Game 0: Online Multiplayer Racing (10 Levels) -->
        <article data-game-card="online_race" class="rounded-2xl overflow-hidden border border-sky-400/40 bg-slate-900/95 flex flex-col shadow-xl sm:col-span-2">
          <div class="bg-gradient-to-r from-sky-900 via-indigo-900 to-cyan-900 p-5 relative overflow-hidden flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-400/20 text-emerald-200 border border-emerald-300/30 flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  3D Гонки • 10 уровней
                </span>
                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-400/20 text-amber-200 border border-amber-300/30">До +25 🪙</span>
              </div>
              <h2 data-card-title="online_race" class="text-xl font-extrabold text-white mt-3">Гонки 3D Онлайн: 10 уровней</h2>
              <p data-card-desc="online_race" class="text-xs text-sky-100/85 mt-1 max-w-lg">Улучшенная физика, нитро-пламя, трафик и препятствия! Пройди все 10 уровней с друзьями и онлайн-игроками.</p>
            </div>
            <div class="text-5xl self-end sm:self-center">🏁</div>
          </div>
          <div class="p-4 flex items-center justify-between bg-slate-900">
            <div class="text-xs text-slate-300">
              <span class="text-emerald-400 font-semibold">Пройдено: <strong id="card-race-progress">0</strong>/10</span> • +1 заезд
            </div>
            <button type="button" data-open-game="online_race" class="px-5 py-2.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-extrabold text-sm flex items-center gap-1.5 transition-colors shadow-lg shadow-sky-500/20">
              <i data-lucide="flag" class="w-4 h-4"></i>
              <span>Войти в лобби</span>
            </button>
          </div>
        </article>

        <!-- Game 5: Riddles 30 Levels -->
        <article data-game-card="riddles" class="rounded-2xl overflow-hidden border border-amber-400/35 bg-slate-900/90 flex flex-col shadow-lg sm:col-span-2">
          <div class="card-gradient-5 p-5 relative overflow-hidden flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-white/15 text-white">Викторина • 150 уровней</span>
                <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-300/20 text-amber-100 border border-amber-200/30">+3 🪙 за уровень</span>
              </div>
              <h2 data-card-title="riddles" class="text-lg font-extrabold text-white mt-3">Загадки за монеты: 150 уровней</h2>
              <p data-card-desc="riddles" class="text-xs text-amber-100/85 mt-1 max-w-md">150 уникальных уровней загадок! За каждый пройденный уровень получай +3 🪙 на баланс и +1 заезд.</p>
            </div>
            <div class="text-4xl self-end sm:self-center">🧩</div>
          </div>
          <div class="p-4 flex items-center justify-between bg-slate-900">
            <div class="text-xs text-slate-300">
              <span class="text-amber-300 font-semibold">Пройдено: <strong id="card-riddles-progress">0</strong>/150</span> • +1 заезд
            </div>
            <button type="button" data-open-game="riddles" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm flex items-center gap-1.5 transition-colors">
              <i data-lucide="play" class="w-4 h-4 fill-current"></i>
              <span>Играть</span>
            </button>
          </div>
        </article>

        <!-- Game 1: Neon Drift -->
        <article data-game-card="drift" class="rounded-2xl overflow-hidden border border-white/10 bg-slate-900/90 flex flex-col shadow-lg hover:border-sky-400/40 transition-all">
          <div class="card-gradient-1 p-5 relative overflow-hidden">
            <div class="flex items-start justify-between">
              <span class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-white/15 text-white backdrop-blur-sm">Гонки</span>
              <span class="text-3xl">🏎️</span>
            </div>
            <h2 data-card-title="drift" class="text-lg font-extrabold text-white mt-4">Неоновый Дрифт</h2>
            <p data-card-desc="drift" class="text-xs text-indigo-100/80 mt-1">Уворачивайся от машин по 3 полосам и доберись до финиша за 12 сек.</p>
          </div>
          <div class="p-4 flex items-center justify-between bg-slate-900 mt-auto">
            <div class="text-xs text-slate-400"><span class="text-emerald-400 font-semibold">+1 заезд</span> к бонусу</div>
            <button type="button" data-open-game="drift" class="px-4 py-2 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-sm flex items-center gap-1.5 transition-colors">
              <i data-lucide="play" class="w-4 h-4 fill-current"></i>
              <span>Играть</span>
            </button>
          </div>
        </article>

        <!-- Game 2: Turbo Sprint -->
        <article data-game-card="turbo" class="rounded-2xl overflow-hidden border border-white/10 bg-slate-900/90 flex flex-col shadow-lg hover:border-emerald-400/40 transition-all">
          <div class="card-gradient-2 p-5 relative overflow-hidden">
            <div class="flex items-start justify-between">
              <span class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-white/15 text-white backdrop-blur-sm">Драг-рейс</span>
              <span class="text-3xl">⚡</span>
            </div>
            <h2 data-card-title="turbo" class="text-lg font-extrabold text-white mt-4">Турбо Спринт</h2>
            <p data-card-desc="turbo" class="text-xs text-emerald-100/80 mt-1">Нажимай «ГАЗ!» в зелёной зоне тахометра и обгони соперника.</p>
          </div>
          <div class="p-4 flex items-center justify-between bg-slate-900 mt-auto">
            <div class="text-xs text-slate-400"><span class="text-emerald-400 font-semibold">+1 заезд</span> к бонусу</div>
            <button type="button" data-open-game="turbo" class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm flex items-center gap-1.5 transition-colors">
              <i data-lucide="play" class="w-4 h-4 fill-current"></i>
              <span>Играть</span>
            </button>
          </div>
        </article>

        <!-- Game 3: Astro -->
        <article data-game-card="astro" class="rounded-2xl overflow-hidden border border-white/10 bg-slate-900/90 flex flex-col shadow-lg hover:border-violet-400/40 transition-all">
          <div class="card-gradient-3 p-5 relative overflow-hidden">
            <div class="flex items-start justify-between">
              <span class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-white/15 text-white">Аркада</span>
              <span class="text-3xl">🚀</span>
            </div>
            <h2 data-card-title="astro" class="text-lg font-extrabold text-white mt-4">Космо-Трасса</h2>
            <p data-card-desc="astro" class="text-xs text-violet-100/80 mt-1">Управляй кораблём, облетай астероиды и пройди гипер-врата за 12 секунд.</p>
          </div>
          <div class="p-4 flex items-center justify-between bg-slate-900 mt-auto">
            <div class="text-xs text-slate-400"><span class="text-emerald-400 font-semibold">+1 заезд</span> к бонусу</div>
            <button type="button" data-open-game="astro" class="px-4 py-2 rounded-xl bg-violet-500 hover:bg-violet-400 text-white font-bold text-sm flex items-center gap-1.5 transition-colors">
              <i data-lucide="play" class="w-4 h-4 fill-current"></i>
              <span>Играть</span>
            </button>
          </div>
        </article>

        <!-- Game 4: Match-3 -->
        <article data-game-card="match3" class="rounded-2xl overflow-hidden border border-white/10 bg-slate-900/90 flex flex-col shadow-lg hover:border-pink-400/40 transition-all">
          <div class="card-gradient-4 p-5 relative overflow-hidden">
            <div class="flex items-start justify-between">
              <span class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-white/15 text-white">Головоломка</span>
              <span class="text-3xl">💎</span>
            </div>
            <h2 data-card-title="match3" class="text-lg font-extrabold text-white mt-4">3 в ряд</h2>
            <p data-card-desc="match3" class="text-xs text-pink-100/80 mt-1">Меняй кристаллы местами, набирай 120 очков за 12 ходов и получай +5 🪙.</p>
          </div>
          <div class="p-4 flex items-center justify-between bg-slate-900 mt-auto">
            <div class="text-xs text-slate-400"><span class="text-amber-300 font-semibold">+5 🪙</span> и +1 заезд</div>
            <button type="button" data-open-game="match3" class="px-4 py-2 rounded-xl bg-pink-500 hover:bg-pink-400 text-white font-bold text-sm flex items-center gap-1.5 transition-colors">
              <i data-lucide="play" class="w-4 h-4 fill-current"></i>
              <span>Играть</span>
            </button>
          </div>
        </article>
      </div>
    </section>

    <!-- SECTION: ACTIVE GAME VIEW -->
    <section id="view-play" class="hidden space-y-4 animate-slide-up">
      <div class="flex items-center justify-between gap-2">
        <button id="back-to-games-btn" type="button" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-white/10 text-sm font-semibold text-slate-200 flex items-center gap-1.5 transition-colors">
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
          <span>К списку игр</span>
        </button>
        <div class="text-center">
          <h2 id="active-game-title" class="text-base font-extrabold text-white">Игра</h2>
          <p id="active-game-subtitle" class="text-[11px] text-slate-400">Заезд 0/3</p>
        </div>
        <div class="px-3 py-1.5 rounded-xl bg-slate-800/80 border border-white/10 text-xs font-bold text-sky-300 tabular-nums" id="game-hud-timer">
          12.0s
        </div>
      </div>

      <!-- Canvas Container -->
      <div id="canvas-wrapper" class="relative rounded-2xl overflow-hidden border border-white/15 bg-slate-950 shadow-2xl">
        <canvas id="game-canvas" class="w-full h-[380px] sm:h-[420px]"></canvas>
        <div id="three-race-container" class="hidden w-full h-[380px] sm:h-[420px]"></div>
        <div id="game-overlay" class="absolute inset-0 bg-slate-950/85 backdrop-blur-sm flex flex-col items-center justify-center p-6 text-center">
          <div id="overlay-emoji" class="text-5xl mb-3">🏎️</div>
          <h3 id="overlay-title" class="text-xl font-extrabold text-white">Готов к заезду?</h3>
          <p id="overlay-desc" class="text-sm text-slate-300 mt-1.5 max-w-xs">Доберись до финиша, чтобы заезд засчитался в награду.</p>
          <button id="game-start-btn" type="button" class="mt-5 px-6 py-3 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-extrabold text-sm shadow-lg shadow-sky-500/25 transition-all active:scale-95">
            Начать заезд
          </button>
        </div>
      </div>

      <!-- Match-3 Container -->
      <div id="match3-wrapper" class="hidden rounded-2xl p-4 sm:p-5 border border-white/15 bg-slate-900/95 shadow-2xl space-y-4">
        <div class="flex items-center justify-between text-sm">
          <div class="px-3 py-1.5 rounded-xl bg-slate-950 border border-white/10">Очки: <strong id="m3-score" class="text-pink-400">0</strong> / 120</div>
          <div class="px-3 py-1.5 rounded-xl bg-slate-950 border border-white/10">Ходы: <strong id="m3-moves" class="text-sky-400">12</strong></div>
        </div>
        <div id="m3-board" class="grid grid-cols-6 gap-1.5 sm:gap-2 max-w-xs mx-auto select-none"></div>
        <div class="text-center text-xs text-slate-400">Выбери кристалл, затем соседний, чтобы собрать 3 или более в ряд.</div>
      </div>

      <!-- Riddles Container (30 Levels) -->
      <div id="riddles-wrapper" class="hidden rounded-2xl p-5 border border-white/15 bg-slate-900/95 shadow-2xl space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-bold">
          <span class="px-3 py-1 rounded-full bg-amber-500/15 text-amber-300 border border-amber-400/30">
            Уровень <span id="rid-level-num">1</span> / 150
          </span>
          <span class="text-emerald-400">Пройдено уровней: <span id="rid-solved-count">0</span> / 150</span>
        </div>

        <!-- 30 Level Selector Grid -->
        <div id="rid-pages-tabs" class="flex flex-wrap gap-1.5"></div>
        <div id="rid-levels-grid" class="grid grid-cols-6 sm:grid-cols-10 gap-1.5"></div>

        <div class="p-4 rounded-2xl bg-slate-950 border border-white/10">
          <p id="rid-question" class="text-base font-bold text-white leading-relaxed"></p>
        </div>
        <div id="rid-options" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5"></div>
        <div id="rid-feedback" class="hidden text-center text-sm font-bold py-2"></div>
      </div>

      <!-- Online Race Lobby (10 Levels) -->
      <div id="online-lobby-wrapper" class="hidden rounded-2xl p-5 border border-sky-400/25 bg-slate-900/95 shadow-2xl space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-sky-400">Комната #482 • Уровень <span id="or-lobby-level">1</span>/10</span>
            <h3 class="text-lg font-extrabold text-white" id="or-level-name">Ночной Старт</h3>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" data-track-select="night" class="track-btn px-3 py-1.5 rounded-xl bg-sky-500/20 border border-sky-400 text-sky-200 text-xs font-bold">🌃 Ночь</button>
            <button type="button" data-track-select="highway" class="track-btn px-3 py-1.5 rounded-xl bg-slate-950 border border-white/10 text-slate-300 text-xs font-bold">🛣️ Шоссе</button>
          </div>
        </div>

        <!-- 10 Race Levels Selector -->
        <div class="space-y-1.5">
          <div class="text-xs font-bold text-slate-300 flex items-center justify-between">
            <span>Выбери уровень гонки (1–10)</span>
            <span class="text-amber-300" id="or-level-reward">Приз за 1 место: +12 🪙</span>
          </div>
          <div id="or-levels-grid" class="grid grid-cols-5 sm:grid-cols-10 gap-1.5"></div>
        </div>

        <!-- Room Roster -->
        <div class="space-y-2">
          <div class="text-xs font-bold text-slate-300 flex items-center justify-between">
            <span>Участники заезда</span>
            <span id="lobby-players-count" class="text-sky-400">4 / 6</span>
          </div>
          <div id="lobby-roster" class="grid grid-cols-1 sm:grid-cols-2 gap-2"></div>
        </div>

        <!-- Invite Friends -->
        <div class="space-y-2">
          <div class="text-xs font-bold text-slate-300">Пригласить друзей в гонку</div>
          <div id="lobby-invite-friends" class="flex flex-wrap gap-2"></div>
        </div>

        <button id="start-online-race-btn" type="button" class="w-full py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold text-sm flex items-center justify-center gap-2 shadow-lg shadow-emerald-500/20 transition-all active:scale-[0.99]">
          <i data-lucide="play" class="w-4 h-4 fill-current"></i>
          <span>Старт гонки (Уровень <span id="or-btn-level">1</span>)!</span>
        </button>
      </div>

      <!-- Online Race Live HUD & Controls -->
      <div id="online-race-hud" class="hidden space-y-3">
        <div class="grid grid-cols-4 gap-2 text-center">
          <div class="p-2 rounded-xl bg-slate-900 border border-white/10">
            <div class="text-[10px] text-slate-400 uppercase font-bold">Уровень</div>
            <div id="or-hud-level" class="text-sm font-extrabold text-white">1/10</div>
          </div>
          <div class="p-2 rounded-xl bg-slate-900 border border-white/10">
            <div class="text-[10px] text-slate-400 uppercase font-bold">Место</div>
            <div id="or-place" class="text-sm font-extrabold text-amber-300">1 / 4</div>
          </div>
          <div class="p-2 rounded-xl bg-slate-900 border border-white/10">
            <div class="text-[10px] text-slate-400 uppercase font-bold">Скорость</div>
            <div id="or-speed" class="text-sm font-extrabold text-sky-300 tabular-nums">120 км/ч</div>
          </div>
          <div class="p-2 rounded-xl bg-slate-900 border border-white/10">
            <div class="text-[10px] text-slate-400 uppercase font-bold">Нитро</div>
            <div id="or-nitro" class="text-sm font-extrabold text-emerald-300 tabular-nums">100%</div>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-2.5">
          <button id="or-left" type="button" class="py-4 rounded-2xl bg-slate-800 hover:bg-slate-700 active:bg-sky-500/30 border border-white/10 font-bold text-sm flex items-center justify-center gap-1 select-none">
            <i data-lucide="chevron-left" class="w-5 h-5"></i>
            <span>Влево</span>
          </button>
          <button id="or-nitro-btn" type="button" class="py-4 rounded-2xl bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 font-extrabold text-sm flex items-center justify-center gap-1.5 shadow-lg shadow-amber-500/20 select-none">
            <i data-lucide="flame" class="w-5 h-5 fill-current"></i>
            <span>НИТРО</span>
          </button>
          <button id="or-right" type="button" class="py-4 rounded-2xl bg-slate-800 hover:bg-slate-700 active:bg-sky-500/30 border border-white/10 font-bold text-sm flex items-center justify-center gap-1 select-none">
            <span>Вправо</span>
            <i data-lucide="chevron-right" class="w-5 h-5"></i>
          </button>
        </div>
      </div>

      <!-- Touch Controls for Drift/Astro/Turbo -->
      <div id="controls-lanes" class="grid grid-cols-2 gap-3">
        <button id="ctrl-left" type="button" class="py-4 rounded-2xl bg-slate-800 hover:bg-slate-700 active:bg-sky-500/30 border border-white/10 font-bold text-base flex items-center justify-center gap-2 select-none">
          <i data-lucide="chevron-left" class="w-5 h-5"></i>
          <span>Влево</span>
        </button>
        <button id="ctrl-right" type="button" class="py-4 rounded-2xl bg-slate-800 hover:bg-slate-700 active:bg-sky-500/30 border border-white/10 font-bold text-base flex items-center justify-center gap-2 select-none">
          <span>Вправо</span>
          <i data-lucide="chevron-right" class="w-5 h-5"></i>
        </button>
      </div>
      <div id="controls-turbo" class="hidden">
        <button id="ctrl-boost" type="button" class="w-full py-4 rounded-2xl bg-emerald-500 hover:bg-emerald-400 active:scale-[0.98] text-slate-950 font-extrabold text-base flex items-center justify-center gap-2 shadow-lg shadow-emerald-500/20 select-none transition-all">
          <i data-lucide="zap" class="w-5 h-5 fill-current"></i>
          <span>ГАЗ! (или Пробел)</span>
        </button>
      </div>

      <div class="rounded-2xl p-4 bg-slate-900/90 border border-white/10 flex items-center justify-between gap-3">
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-10 h-10 rounded-xl bg-sky-500/15 border border-sky-400/30 flex items-center justify-center text-xl shrink-0">🧑‍🚀</div>
          <div class="min-w-0">
            <div class="text-sm font-extrabold text-white">Аватар</div>
            <div class="text-xs text-slate-400 truncate">Кастомизация персонажа (скоро будет)</div>
          </div>
        </div>
        <button id="games-to-avatar-btn" type="button" class="px-4 py-2 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-xs shrink-0 transition-colors">
          Открыть Аватар
        </button>
      </div>
    </section>

    <!-- SECTION: SHOP -->
    <section id="view-shop" class="hidden space-y-5 animate-slide-up">
      <div class="flex items-center justify-between gap-3">
        <div>
          <h1 class="text-2xl font-extrabold tracking-tight text-white">Магазин</h1>
          <p class="text-sm text-slate-400 mt-0.5">Трать заработанные монетки на привилегии</p>
        </div>
        <div class="px-3 py-1.5 rounded-xl bg-amber-500/15 border border-amber-400/30 text-amber-300 text-xs font-bold">
          Баланс: 🪙 <span id="shop-balance">0</span>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4">
        <!-- Item: Adminka -->
        <div class="rounded-2xl p-5 bg-gradient-to-br from-rose-500/20 via-slate-900 to-slate-900 border border-rose-400/40 shadow-xl space-y-4">
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-center gap-3.5">
              <div class="w-14 h-14 rounded-2xl bg-rose-500/20 border border-rose-400/40 flex items-center justify-center text-3xl shrink-0">
                👑
              </div>
              <div>
                <span class="px-2 py-0.5 rounded-md bg-rose-500/25 text-rose-300 text-[10px] font-extrabold uppercase tracking-wider">VIP Привилегия</span>
                <h2 class="text-xl font-extrabold text-white mt-1">Админка</h2>
