        <p class="text-sm text-slate-400 mt-0.5">Добавляй игроков в друзья — после отправки заявки нужно подождать, пока её примут</p>
      </div>

      <form id="add-friend-form" class="rounded-2xl p-4 bg-slate-900/90 border border-white/10 flex flex-col sm:flex-row gap-2.5">
        <div class="relative flex-1">
          <i data-lucide="user-plus" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
          <input id="friend-username-input" type="text" maxlength="24" placeholder="Введи юзернейм игрока..." class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-950 border border-white/15 text-white text-sm focus:outline-none focus:border-sky-400 transition-colors" />
        </div>
        <button type="submit" class="px-5 py-2.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-sm shrink-0 transition-colors">Кинуть заявку</button>
      </form>

      <div class="space-y-2.5">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold text-slate-200 flex items-center gap-2">
            <i data-lucide="clock" class="w-4 h-4 text-amber-400"></i>
            <span>Отправленные заявки (ожидание)</span>
          </h2>
          <span id="pending-count-badge" class="px-2 py-0.5 rounded-full text-xs font-bold bg-amber-500/15 text-amber-300">0</span>
        </div>
        <div id="pending-friends-list" class="space-y-2 no-copy"></div>
      </div>

      <div class="space-y-2.5">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold text-slate-200 flex items-center gap-2">
            <i data-lucide="users" class="w-4 h-4 text-emerald-400"></i>
            <span>Мои друзья</span>
          </h2>
          <span id="friends-count-badge" class="px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-500/15 text-emerald-300">0</span>
        </div>
        <div id="accepted-friends-list" class="space-y-2 no-copy"></div>
      </div>

      <div class="space-y-2.5">
        <h2 class="text-sm font-bold text-slate-200 flex items-center gap-2">
          <i data-lucide="sparkles" class="w-4 h-4 text-sky-400"></i>
          <span>Игроки в сети</span>
        </h2>
        <div id="suggested-players-list" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 no-copy"></div>
      </div>
    </section>

    <!-- SECTION: PRIVATE ADMIN PANEL -->
    <section id="view-admin" class="hidden space-y-5 animate-slide-up">
      <div class="flex items-center justify-between gap-3">
        <div>
          <span class="px-2 py-0.5 rounded-md bg-rose-500/20 border border-rose-400/40 text-[11px] font-extrabold text-rose-300">ТОЛЬКО ДЛЯ ВЛАДЕЛЬЦА</span>
          <h1 class="text-2xl font-extrabold tracking-tight text-white mt-1">Админ-панель</h1>
          <p class="text-sm text-slate-400 mt-0.5">Скрытая панель управления — обычные игроки её не видят</p>
        </div>
        <button id="admin-logout-btn" type="button" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-rose-500/20 border border-white/10 hover:border-rose-400/40 text-xs font-bold text-slate-200 hover:text-rose-200 transition-colors shrink-0">Выйти из админа</button>
      </div>

      <div class="grid grid-cols-2 gap-2 p-1 rounded-2xl bg-slate-900 border border-white/10">
        <button type="button" data-admin-subtab="settings" class="admin-subtab-btn py-2 rounded-xl bg-rose-500/20 text-rose-200 border border-rose-400/30 text-xs font-extrabold transition-colors">⚙️ Управление и дизайн</button>
        <button type="button" data-admin-subtab="players" class="admin-subtab-btn py-2 rounded-xl text-slate-400 hover:text-white text-xs font-extrabold transition-colors">👥 Игроки (<span id="admin-players-tab-count">0</span>)</button>
      </div>

      <div id="admin-panel-settings" class="space-y-5">
        <div class="rounded-2xl p-5 bg-slate-900/90 border border-rose-500/25 space-y-3">
          <h2 class="text-sm font-bold text-white flex items-center gap-2"><i data-lucide="coins" class="w-4 h-4 text-amber-400"></i><span>Мой баланс и заезды</span></h2>
          <div class="flex flex-wrap gap-2">
            <button type="button" data-admin-coins="10" class="px-3.5 py-2 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/30 text-amber-200 text-xs font-bold">+10 🪙</button>
            <button type="button" data-admin-coins="50" class="px-3.5 py-2 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/30 text-amber-200 text-xs font-bold">+50 🪙</button>
            <button type="button" data-admin-coins="100" class="px-3.5 py-2 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/30 text-amber-200 text-xs font-bold">+100 🪙</button>
            <button type="button" data-admin-coins="-10" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-white/10 text-slate-300 text-xs font-bold">-10 🪙</button>
            <button type="button" id="admin-complete-daily" class="px-3.5 py-2 rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-400/30 text-emerald-200 text-xs font-bold">Засчитать 3/3 заезда</button>
          </div>
        </div>

        <form id="admin-give-player-coins-form" class="rounded-2xl p-5 bg-slate-900/90 border border-white/10 space-y-3">
          <h2 class="text-sm font-bold text-white flex items-center gap-2"><i data-lucide="send" class="w-4 h-4 text-amber-400"></i><span>Выдать монеты игроку</span></h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <input id="admin-target-player" type="text" placeholder="Ник игрока" class="px-3.5 py-2 rounded-xl bg-slate-950 border border-white/15 text-white text-xs focus:outline-none focus:border-amber-400" />
            <input id="admin-target-amount" type="number" min="1" max="10000" value="25" class="px-3.5 py-2 rounded-xl bg-slate-950 border border-white/15 text-white text-xs focus:outline-none focus:border-amber-400" />
            <button type="submit" class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs transition-colors">Выдать 🪙</button>
          </div>
          <div id="admin-player-balances" class="flex flex-wrap gap-2 text-[11px] text-slate-300"></div>
        </form>

        <form id="admin-home-text-form" class="rounded-2xl p-5 bg-slate-900/90 border border-white/10 space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-bold text-white flex items-center gap-2"><i data-lucide="megaphone" class="w-4 h-4 text-sky-400"></i><span>Текст на главном экране</span></h2>
            <label class="flex items-center gap-2 text-xs text-slate-300 cursor-pointer"><input id="admin-banner-enabled" type="checkbox" class="rounded bg-slate-950 border-white/20 text-sky-500" /><span>Показывать</span></label>
          </div>
          <input id="admin-banner-title" type="text" maxlength="60" placeholder="Заголовок объявления..." class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-white/15 text-white text-xs focus:outline-none focus:border-sky-400" />
          <textarea id="admin-banner-body" rows="2" maxlength="160" placeholder="Текст объявления..." class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-white/15 text-white text-xs focus:outline-none focus:border-sky-400 resize-none"></textarea>
          <button type="submit" class="px-4 py-2 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-extrabold text-xs transition-colors">Сохранить текст</button>
        </form>

        <div class="rounded-2xl p-5 bg-slate-900/90 border border-white/10 space-y-3">
          <h2 class="text-sm font-bold text-white flex items-center gap-2"><i data-lucide="palette" class="w-4 h-4 text-pink-400"></i><span>Дизайн игры ZOOCLOC</span></h2>
          <div class="flex flex-wrap gap-2">
            <button type="button" data-theme-preset="default" class="px-3 py-1.5 rounded-xl bg-slate-950 border border-white/15 text-xs font-bold text-sky-300">🌑 Тёмный неон</button>
            <button type="button" data-theme-preset="cyber" class="px-3 py-1.5 rounded-xl bg-purple-950 border border-purple-400/30 text-xs font-bold text-pink-300">🔮 Киберпанк</button>
            <button type="button" data-theme-preset="gold" class="px-3 py-1.5 rounded-xl bg-amber-950 border border-amber-400/30 text-xs font-bold text-amber-300">👑 Золотой люкс</button>
            <button type="button" data-theme-preset="emerald" class="px-3 py-1.5 rounded-xl bg-emerald-950 border border-emerald-400/30 text-xs font-bold text-emerald-300">🌿 Изумруд</button>
          </div>
          <div class="grid grid-cols-2 gap-3 pt-1">
            <label class="flex items-center justify-between px-3 py-2 rounded-xl bg-slate-950 border border-white/10 text-xs text-slate-300"><span>Фон сайта</span><input id="admin-bg-color" type="color" value="#0b0f19" class="w-7 h-7 rounded cursor-pointer bg-transparent border-0" /></label>
            <label class="flex items-center justify-between px-3 py-2 rounded-xl bg-slate-950 border border-white/10 text-xs text-slate-300"><span>Цвет акцента</span><input id="admin-accent-color" type="color" value="#38bdf8" class="w-7 h-7 rounded cursor-pointer bg-transparent border-0" /></label>
          </div>
        </div>

        <form id="admin-edit-game-form" class="rounded-2xl p-5 bg-slate-900/90 border border-white/10 space-y-3">
          <h2 class="text-sm font-bold text-white flex items-center gap-2"><i data-lucide="sliders" class="w-4 h-4 text-emerald-400"></i><span>Редактор игр</span></h2>
          <select id="admin-game-select" class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-white/15 text-white text-xs focus:outline-none focus:border-emerald-400">
            <option value="online_race">Гонки Онлайн (10 уровней)</option>
            <option value="riddles">Загадки за монеты (150 уровней)</option>
            <option value="drift">Неоновый Дрифт</option>
            <option value="turbo">Турбо Спринт</option>
            <option value="astro">Космо-Трасса</option>
            <option value="match3">3 в ряд</option>
          </select>
          <input id="admin-game-title-input" type="text" maxlength="48" placeholder="Название игры" class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-white/15 text-white text-xs focus:outline-none focus:border-emerald-400" />
          <textarea id="admin-game-desc-input" rows="2" maxlength="140" placeholder="Описание игры" class="w-full px-3.5 py-2 rounded-xl bg-slate-950 border border-white/15 text-white text-xs focus:outline-none focus:border-emerald-400 resize-none"></textarea>
          <div class="flex items-center justify-between">
            <label class="flex items-center gap-2 text-xs text-slate-300 cursor-pointer"><input id="admin-game-visible" type="checkbox" checked class="rounded bg-slate-950 border-white/20 text-emerald-500" /><span>Показывать игру в списке</span></label>
            <button type="submit" class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold text-xs transition-colors">Применить к игре</button>
          </div>
        </form>

        <div class="rounded-2xl p-5 bg-slate-900/90 border border-rose-400/25 space-y-2">
          <h2 class="text-sm font-bold text-white flex items-center gap-2"><i data-lucide="key-round" class="w-4 h-4 text-rose-400"></i><span>Пароли (PIN) для входа в админку</span></h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
            <div class="p-2.5 rounded-xl bg-slate-950 border border-white/10"><span class="text-slate-400">Владелец:</span> <strong class="text-white">7777</strong></div>
            <div class="p-2.5 rounded-xl bg-slate-950 border border-white/10"><span class="text-slate-400">Для Глеба:</span> <strong class="text-sky-300">2468</strong></div>
            <div class="p-2.5 rounded-xl bg-slate-950 border border-white/10"><span class="text-slate-400">Запасной:</span> <strong class="text-amber-300">9090</strong></div>
          </div>
        </div>

        <div class="rounded-2xl p-5 bg-slate-900/90 border border-white/10 space-y-2">
          <h2 class="text-sm font-bold text-white flex items-center gap-2"><i data-lucide="user-check" class="w-4 h-4 text-sky-400"></i><span>Заявки в друзья</span></h2>
          <div id="admin-pending-list" class="space-y-2 text-xs text-slate-400"></div>
        </div>
      </div>

      <div id="admin-panel-players" class="hidden space-y-5">
        <div class="rounded-2xl p-5 bg-slate-900/90 border border-emerald-400/25 space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-bold text-white flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span><span>ОНЛАЙН игроки</span></h2>
            <span id="admin-online-count" class="px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-500/15 text-emerald-300">0</span>
          </div>
          <div id="admin-online-players-list" class="space-y-2"></div>
        </div>
        <div class="rounded-2xl p-5 bg-slate-900/90 border border-white/10 space-y-3">
          <div class="flex items-center justify-between">
            <h2 class="text-sm font-bold text-white flex items-center gap-2"><i data-lucide="database" class="w-4 h-4 text-sky-400"></i><span>Все ЗАРЕГИСТРИРОВАННЫЕ игроки</span></h2>
            <span id="admin-registered-count" class="px-2 py-0.5 rounded-full text-xs font-bold bg-sky-500/15 text-sky-300">0</span>
          </div>
          <div id="admin-registered-players-list" class="space-y-2"></div>
        </div>
      </div>
    </section>
  </main>

  <!-- Admin PIN Modal -->
  <div id="admin-modal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <form id="admin-pin-form" class="w-full max-w-xs rounded-2xl p-5 bg-slate-900 border border-white/15 shadow-2xl space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-extrabold text-white flex items-center gap-2"><i data-lucide="shield" class="w-4 h-4 text-rose-400"></i><span>Вход для админа</span></h3>
        <button id="admin-modal-close" type="button" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>
      <p class="text-xs text-slate-400">Введи секретный PIN владельца, чтобы открыть профиль админа и админ-панель.</p>
      <input id="admin-pin-input" type="password" inputmode="numeric" maxlength="12" placeholder="PIN-код..." class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-white/15 text-white text-sm focus:outline-none focus:border-rose-400" />
      <button type="submit" class="w-full py-2.5 rounded-xl bg-rose-500 hover:bg-rose-400 text-white font-bold text-sm transition-colors">Войти</button>
    </form>
  </div>

  <!-- Admin Player Profile Modal -->
  <div id="admin-player-modal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl p-5 bg-slate-900 border border-white/15 shadow-2xl space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-extrabold text-white">Профиль игрока</h3>
        <button id="admin-player-modal-close" type="button" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
      </div>
      <div class="flex items-center gap-3.5 no-copy">
        <div id="apm-avatar" class="w-16 h-16 rounded-2xl bg-slate-800 border border-white/15 flex items-center justify-center text-3xl shrink-0">🎮</div>
        <div class="min-w-0">
          <div class="flex items-center gap-2"><span id="apm-username" class="text-lg font-extrabold text-white truncate"></span><span id="apm-status-badge" class="px-2 py-0.5 rounded-full text-[10px] font-bold"></span></div>
          <p id="apm-bio" class="text-xs text-slate-300 mt-1"></p>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-2 text-xs">
        <div class="p-3 rounded-xl bg-slate-950 border border-white/10"><div class="text-slate-400">Баланс</div><div id="apm-coins" class="text-base font-extrabold text-amber-300 mt-0.5">0 🪙</div></div>
        <div class="p-3 rounded-xl bg-slate-950 border border-white/10"><div class="text-slate-400">Заездов</div><div id="apm-runs" class="text-base font-extrabold text-sky-300 mt-0.5">0</div></div>
      </div>
      <div class="flex flex-wrap gap-2 pt-1">
        <button id="apm-give-25" type="button" class="flex-1 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs">+25 🪙</button>
        <button id="apm-mute-toggle" type="button" class="flex-1 py-2 rounded-xl font-extrabold text-xs"></button>
        <button id="apm-ban-toggle" type="button" class="flex-1 py-2 rounded-xl font-extrabold text-xs"></button>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast-container" class="fixed top-20 right-4 z-50 flex flex-col gap-2 max-w-xs w-full pointer-events-none"></div>

  <!-- Bottom Navigation Bar -->
  <nav class="fixed bottom-0 inset-x-0 z-40 glass border-t border-white/10">
    <div class="max-w-3xl mx-auto px-0.5 h-18 py-1.5 grid grid-cols-7 gap-0.5">
      <button type="button" data-tab="games" class="nav-btn nav-active flex flex-col items-center justify-center gap-1 py-1.5 rounded-xl transition-colors">
        <div class="nav-pill px-2 py-1 rounded-full transition-colors"><i data-lucide="gamepad-2" class="w-5 h-5"></i></div>
        <span class="text-[10px] font-semibold">Игры</span>
      </button>
      <button type="button" data-tab="shop" class="nav-btn text-slate-400 hover:text-slate-200 flex flex-col items-center justify-center gap-1 py-1.5 rounded-xl transition-colors">
        <div class="nav-pill px-1.5 py-1 rounded-full transition-colors"><i data-lucide="shopping-bag" class="w-4 h-4 sm:w-5 sm:h-5"></i></div>
        <span class="text-[9px] sm:text-[10px] font-semibold">Магазин</span>
      </button>
      <button type="button" data-tab="avatar" class="nav-btn text-slate-400 hover:text-slate-200 flex flex-col items-center justify-center gap-1 py-1.5 rounded-xl transition-colors">
        <div class="nav-pill px-1.5 py-1 rounded-full transition-colors"><i data-lucide="sparkles" class="w-4 h-4 sm:w-5 sm:h-5"></i></div>
        <span class="text-[9px] sm:text-[10px] font-semibold">Avatar</span>
      </button>
      <button type="button" data-tab="chat" class="nav-btn text-slate-400 hover:text-slate-200 flex flex-col items-center justify-center gap-1 py-1.5 rounded-xl transition-colors">
        <div class="nav-pill px-2.5 py-1 rounded-full transition-colors"><i data-lucide="message-circle" class="w-5 h-5"></i></div>
        <span class="text-[11px] font-semibold">Чат</span>
      </button>
      <button type="button" data-tab="profile" class="nav-btn text-slate-400 hover:text-slate-200 flex flex-col items-center justify-center gap-1 py-1.5 rounded-xl transition-colors">
        <div class="nav-pill px-2.5 py-1 rounded-full transition-colors"><i data-lucide="user" class="w-5 h-5"></i></div>
        <span class="text-[11px] font-semibold">Профиль</span>
      </button>
      <button type="button" data-tab="rewards" class="nav-btn text-slate-400 hover:text-slate-200 flex flex-col items-center justify-center gap-1 py-1.5 rounded-xl transition-colors relative">
        <div class="nav-pill px-2.5 py-1 rounded-full transition-colors relative">
          <i data-lucide="gift" class="w-5 h-5"></i>
          <span id="nav-reward-dot" class="hidden absolute top-0.5 right-1.5 w-2 h-2 rounded-full bg-amber-400"></span>
        </div>
        <span class="text-[11px] font-semibold">Награды</span>
      </button>
      <button type="button" data-tab="friends" class="nav-btn text-slate-400 hover:text-slate-200 flex flex-col items-center justify-center gap-1 py-1.5 rounded-xl transition-colors relative">
        <div class="nav-pill px-2.5 py-1 rounded-full transition-colors relative"><i data-lucide="users" class="w-5 h-5"></i></div>
        <span class="text-[11px] font-semibold">Друзья</span>
      </button>
    </div>
  </nav>

  <script>
    const STORAGE_KEY = 'zoocloc_state_v3';
    const ADMIN_PINS = { '7777': 'Владелец', '2468': 'Глеб', '9090': 'Запасной' };
    const RESERVED_ADMIN_NAMES = ['admin', 'админ', 'владелец', 'owner', 'moderator', 'модератор', 'administrator'];
    const AVATARS = ['🏎️', '🦊', '👾', '🤖', '🐉', '⚡', '🔥', '👑', '🥷', '🚀', '🎮', '🐺'];

    const DEFAULT_SUGGESTED = [
      { id: 'p1', username: 'AlexDrift', avatar: '🏎️', bio: 'Мастер дрифта' },
      { id: 'p2', username: 'NeonFox', avatar: '🦊', bio: 'Играю каждый вечер' },
      { id: 'p3', username: 'TurboMax', avatar: '⚡', bio: 'Охотник за монетками' },
      { id: 'p4', username: 'KiraStar', avatar: '🚀', bio: 'Космо-трасса топ!' }
    ];

    const defaultState = {
      isAdmin: false,
      adminProfile: { username: 'Владелец_Admin', bio: 'Создатель и главный администратор ZOOCLOC 👑', avatar: '👑', customAvatar: null },
      profile: { username: 'Гонщик_01', bio: 'Люблю быстрые заезды и собираю ежедневные награды!', avatar: '🏎️', customAvatar: null },
      balance: 0,
      dailyRuns: 0,
      dailyClaimed: false,
      questProgress: { riddles5: 0, winRace1: 0, match3Win: 0, chat2: 0, friend1: 0 },
      questClaimed: { riddles5: false, winRace1: false, match3Win: false, chat2: false, friend1: false },
      totalRuns: 0,
      rewardsHistory: [],
      friends: [],
      pendingRequests: [],
      soundEnabled: true,
      currentTab: 'games',
      onlineTrack: 'night',
      raceUnlockedLevel: 1,
      raceCompletedLevels: [],
      riddleCurrentLevel: 1,
      riddleSolvedLevels: [],
      match3Progress: null,
      lastSavedAt: null,
      muteUntil: 0,
      chatMessages: [
        { id: 'c1', username: 'AlexDrift', avatar: '🏎️', isAdmin: false, text: 'Всем привет! Кто в Гонки Онлайн на 5 уровень?', time: '14:10' },
        { id: 'c2', username: 'NeonFox', avatar: '🦊', isAdmin: false, text: 'Я уже в лобби, залетайте!', time: '14:12' },
        { id: 'c3', username: 'KiraStar', avatar: '🚀', isAdmin: false, text: 'Прошёл 10 уровней загадок, +30 монеток 🔥', time: '14:15' }
      ],
      registeredPlayers: [
        { id: 'reg_1', username: 'AlexDrift', avatar: '🏎️', bio: 'Мастер дрифта', coins: 40, runs: 18, online: true, banned: false, muteUntil: 0 },
        { id: 'reg_2', username: 'NeonFox', avatar: '🦊', bio: 'Играю каждый вечер', coins: 25, runs: 12, online: true, banned: false, muteUntil: 0 },
        { id: 'reg_3', username: 'TurboMax', avatar: '⚡', bio: 'Охотник за монетками', coins: 60, runs: 27, online: true, banned: false, muteUntil: 0 },
        { id: 'reg_4', username: 'KiraStar', avatar: '🚀', bio: 'Космо-трасса топ!', coins: 35, runs: 9, online: false, banned: false, muteUntil: 0 },
        { id: 'reg_5', username: 'PixelWolf', avatar: '🐺', bio: 'Люблю 3 в ряд', coins: 15, runs: 5, online: false, banned: false, muteUntil: 0 }
      ],
      siteConfig: {
        bgColor: '#0b0f19',
        accentColor: '#38bdf8',
        bannerEnabled: false,
        bannerTitle: 'Добро пожаловать в ZOOCLOC!',
        bannerBody: 'Участвуй в 10 уровнях гонок и 30 уровнях загадок!',
        gameOverrides: {}
      },
      playerCoins: { AlexDrift: 40, NeonFox: 25, TurboMax: 60, KiraStar: 35 }
    };

    function cloneDefault() { return JSON.parse(JSON.stringify(defaultState)); }
    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return cloneDefault();
        const parsed = JSON.parse(raw);
        return {
          ...cloneDefault(),
          ...parsed,
          profile: { ...defaultState.profile, ...(parsed.profile || {}) },
          adminProfile: { ...defaultState.adminProfile, ...(parsed.adminProfile || {}) },
          siteConfig: { ...defaultState.siteConfig, ...(parsed.siteConfig || {}) }
        };
      } catch (e) { return cloneDefault(); }
    }
    function saveState() {
      try {
        state.lastSavedAt = new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        const stEl = document.getElementById('save-status-text');
        if (stEl) stEl.textContent = `Сохранено в ${state.lastSavedAt}`;
      } catch (e) {}
    }
    window.addEventListener('beforeunload', saveState);
    window.addEventListener('pagehide', saveState);
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') saveState(); });
    setInterval(saveState, 15000);

    let state = loadState();
    let currentTab = 'games';
    let activeGame = null;
    function getActiveProfile() { return state.isAdmin ? state.adminProfile : state.profile; }
    let selectedAvatar = getActiveProfile().avatar;
    let pendingCustomAvatar = getActiveProfile().customAvatar;

    // Anti-copy
    document.addEventListener('copy', (e) => {
      if (e.target && e.target.closest && e.target.closest('.no-copy')) {
        e.preventDefault();
        showToast('Копирование профилей и юзернеймов запрещено!', 'warn');
      }
    });
    document.addEventListener('contextmenu', (e) => {
      if (e.target && e.target.closest && e.target.closest('.no-copy')) e.preventDefault();
    });

    // Audio
    let audioCtx = null;
    function playTone(freq, duration = 0.1, type = 'sine', vol = 0.08) {
      if (!state.soundEnabled) return;
      try {
        if (!audioCtx) {
          const Ctx = window.AudioContext || window.webkitAudioContext;
          if (!Ctx) return;
          audioCtx = new Ctx();
        }
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        gain.gain.setValueAtTime(vol, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start(); osc.stop(audioCtx.currentTime + duration);
      } catch (e) {}
    }
    function playCoinSound() { playTone(880, 0.09, 'triangle', 0.1); setTimeout(() => playTone(1318, 0.18, 'triangle', 0.1), 80); }
    function playCrashSound() { playTone(150, 0.22, 'sawtooth', 0.09); }

    function showToast(msg, type = 'info') {
      const container = document.getElementById('toast-container');
      const el = document.createElement('div');
      const colors = {
        info: 'border-sky-400/40 bg-slate-900/95 text-slate-100',
        success: 'border-emerald-400/40 bg-slate-900/95 text-emerald-200',
        reward: 'border-amber-400/50 bg-slate-900/95 text-amber-200',
        warn: 'border-rose-400/40 bg-slate-900/95 text-rose-200'
      };
      el.className = `pointer-events-auto px-4 py-3 rounded-xl border shadow-xl text-xs font-semibold animate-slide-up ${colors[type] || colors.info}`;
      el.textContent = msg;
      container.appendChild(el);
      setTimeout(() => { el.style.opacity = '0'; el.style.transition = 'opacity 0.25s ease'; setTimeout(() => el.remove(), 260); }, 3200);
    }

    function renderAvatarContent(container, avatarEmoji, customImg) {
      if (customImg) container.innerHTML = `<img src="${customImg}" alt="Аватар" class="w-full h-full object-cover pointer-events-none" draggable="false" />`;
      else container.textContent = avatarEmoji || '🏎️';
    }
    function escapeHtml(str) {
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function renderAll() {
      const prof = getActiveProfile();
      renderAvatarContent(document.getElementById('header-avatar'), prof.avatar, prof.customAvatar);
      document.getElementById('header-username').textContent = prof.username;
      document.getElementById('header-admin-badge').classList.toggle('hidden', !state.isAdmin);
      document.getElementById('admin-header-btn').classList.toggle('hidden', !state.isAdmin);
      document.getElementById('profile-admin-pill').classList.toggle('hidden', !state.isAdmin);

      document.getElementById('balance-value').textContent = state.balance;
      document.getElementById('mini-runs-count').textContent = Math.min(state.dailyRuns, 3);
      document.getElementById('card-race-progress').textContent = (state.raceCompletedLevels || []).length;
      document.getElementById('card-riddles-progress').textContent = (state.riddleSolvedLevels || []).length;

      document.getElementById('sound-toggle-btn').innerHTML = `<i data-lucide="${state.soundEnabled ? 'volume-2' : 'volume-x'}" class="w-4 h-4"></i>`;

      renderAvatarContent(document.getElementById('profile-preview-avatar'), prof.avatar, prof.customAvatar);
      document.getElementById('profile-preview-name').textContent = prof.username;
      document.getElementById('profile-preview-bio').textContent = prof.bio || 'Описание не указано';
      document.getElementById('profile-balance').textContent = state.balance;
      document.getElementById('stat-total-runs').textContent = state.totalRuns;
      document.getElementById('stat-friends-count').textContent = state.friends.length;

      const picker = document.getElementById('avatar-picker');
      picker.innerHTML = '';
      AVATARS.forEach((av) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        const isSelected = !pendingCustomAvatar && selectedAvatar === av;
        btn.className = `h-11 rounded-xl text-xl flex items-center justify-center border transition-all ${isSelected ? 'bg-sky-500/20 border-sky-400 scale-105' : 'bg-slate-950 border-white/10 hover:border-white/30'}`;
        btn.textContent = av;
        btn.addEventListener('click', () => { selectedAvatar = av; pendingCustomAvatar = null; renderAll(); });
        picker.appendChild(btn);
      });

      document.getElementById('rewards-balance').textContent = state.balance;
      const shopBalEl = document.getElementById('shop-balance');
      if (shopBalEl) shopBalEl.textContent = state.balance;
      const buyAdminBtn = document.getElementById('buy-admin-btn');
      if (buyAdminBtn) {
        if (state.boughtAdmin || state.isAdmin) {
          buyAdminBtn.textContent = '✓ Куплено (Админка активна)';
          buyAdminBtn.disabled = true;
          buyAdminBtn.className = 'px-5 py-2.5 rounded-xl bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 font-extrabold text-sm cursor-default';
        } else {
          buyAdminBtn.textContent = 'Купить за 4500 🪙';
          buyAdminBtn.disabled = false;
          buyAdminBtn.className = 'px-5 py-2.5 rounded-xl bg-rose-500 hover:bg-rose-400 text-white font-extrabold text-sm transition-colors shadow-lg shadow-rose-500/25';
        }
      }
      const clampedRuns = Math.min(state.dailyRuns, 3);
      document.getElementById('daily-progress-text').textContent = `${clampedRuns} / 3`;
      document.getElementById('daily-progress-bar').style.width = `${(clampedRuns / 3) * 100}%`;

      const badge = document.getElementById('daily-status-badge');
      if (state.dailyClaimed) {
        badge.textContent = 'Получено (+10 🪙)';
        badge.className = 'shrink-0 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30';
      } else {
        badge.textContent = `Осталось: ${3 - clampedRuns}`;
        badge.className = 'shrink-0 px-2.5 py-1 rounded-full text-xs font-bold bg-slate-800 text-slate-300 border border-white/10';
      }

      const stepsEl = document.getElementById('daily-steps');
      stepsEl.innerHTML = '';
      for (let i = 1; i <= 3; i++) {
        const done = clampedRuns >= i;
        const step = document.createElement('div');
        step.className = `p-2.5 rounded-xl border text-center transition-all ${done ? 'bg-emerald-500/15 border-emerald-400/40 text-emerald-300' : 'bg-slate-950/80 border-white/10 text-slate-400'}`;
        step.innerHTML = `<div class="text-base">${done ? '✅' : '🏁'}</div><div class="text-[11px] font-bold mt-1">Заезд ${i}</div>`;
        stepsEl.appendChild(step);
      }

      const DAILY_QUESTS = [
        { id: 'riddles5', icon: '🧠', title: 'Зоркий глаз', desc: 'Реши 5 загадок за день', target: 5, reward: 15 },
        { id: 'winRace1', icon: '🏎️', title: 'Король асфальта', desc: 'Займи 1 место в Гонках 3D', target: 1, reward: 20 },
        { id: 'match3Win', icon: '💎', title: 'Ювелир', desc: 'Пройди 1 партию в «3 в ряд»', target: 1, reward: 12 },
        { id: 'chat2', icon: '💬', title: 'Душа компании', desc: 'Отправь 2 сообщения в чат', target: 2, reward: 8 },
        { id: 'friend1', icon: '🤝', title: 'Своя банда', desc: 'Кинь заявку в друзья игроку', target: 1, reward: 10 }
      ];
      const qListEl = document.getElementById('daily-quests-list');
      if (qListEl) {
        qListEl.innerHTML = '';
        const qp = state.questProgress || {};
        const qc = state.questClaimed || {};
        DAILY_QUESTS.forEach((q) => {
          const cur = Math.min(q.target, qp[q.id] || 0);
          const done = !!qc[q.id];
          const pct = Math.round((cur / q.target) * 100);
          const card = document.createElement('div');
          card.className = `rounded-2xl p-4 border transition-all flex flex-col justify-between gap-2.5 ${done ? 'bg-emerald-500/10 border-emerald-400/35' : 'bg-slate-900/90 border-white/10'}`;
          card.innerHTML = `
            <div class="flex items-start justify-between gap-2">
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="text-2xl shrink-0">${q.icon}</span>
                <div class="min-w-0">
                  <div class="text-xs font-extrabold text-white truncate">${q.title}</div>
                  <div class="text-[11px] text-slate-400">${q.desc}</div>
                </div>
              </div>
              <span class="shrink-0 px-2 py-0.5 rounded-full text-[10px] font-extrabold ${done ? 'bg-emerald-500/20 text-emerald-300' : 'bg-amber-500/20 text-amber-300'}">
                ${done ? '✓ Выполнено' : `+${q.reward} 🪙`}
              </span>
            </div>
            <div>
              <div class="flex justify-between text-[10px] font-bold text-slate-400 mb-1">
                <span>Прогресс</span>
                <span class="${done ? 'text-emerald-300' : 'text-amber-300'}">${cur} / ${q.target}</span>
              </div>
              <div class="w-full h-2 rounded-full bg-slate-950 overflow-hidden border border-white/5">
                <div class="h-full ${done ? 'bg-emerald-400' : 'bg-amber-400'} transition-all duration-300" style="width:${pct}%"></div>
              </div>
            </div>`;
          qListEl.appendChild(card);
        });
      }

      const historyEl = document.getElementById('rewards-history');
      if (state.rewardsHistory.length === 0) {
        historyEl.innerHTML = '<div class="text-slate-400">Пока нет начислений. Заверши 3 заезда, чтобы получить первые 10 монеток!</div>';
      } else {
        historyEl.innerHTML = '';
        state.rewardsHistory.slice().reverse().forEach((item) => {
          const row = document.createElement('div');
          row.className = 'flex items-center justify-between py-2 border-b border-white/5 last:border-0';
          row.innerHTML = `<span class="text-slate-200 font-medium">${escapeHtml(item.title)}</span><span class="text-amber-300 font-bold">+${item.amount} 🪙</span>`;
          historyEl.appendChild(row);
        });
      }

      const stEl = document.getElementById('save-status-text');
      if (stEl && state.lastSavedAt) stEl.textContent = `Сохранено в ${state.lastSavedAt}`;
      applySiteConfig();
      renderChat();
      renderFriends();
      renderAdminPanel();
      if (window.lucide) lucide.createIcons();
    }

    function applySiteConfig() {
      const cfg = state.siteConfig || defaultState.siteConfig;
      document.body.style.background = cfg.bgColor || '#0b0f19';
      const brandBadge = document.getElementById('brand-title-badge');
      if (brandBadge && cfg.accentColor) {
        brandBadge.style.color = cfg.accentColor;
        brandBadge.style.borderColor = cfg.accentColor + '55';
      }
      const banner = document.getElementById('home-announcement-banner');
      if (cfg.bannerEnabled && (cfg.bannerTitle || cfg.bannerBody)) {
        banner.classList.remove('hidden');
        document.getElementById('home-announcement-title').textContent = cfg.bannerTitle || '';
        document.getElementById('home-announcement-body').textContent = cfg.bannerBody || '';
      } else {
        banner.classList.add('hidden');
      }
      const overrides = cfg.gameOverrides || {};
      Object.keys(GAME_META).forEach((gid) => {
        const card = document.querySelector(`[data-game-card="${gid}"]`);
        const ov = overrides[gid];
        if (!card) return;
        card.classList.toggle('hidden', Boolean(ov && ov.visible === false));
        const tEl = card.querySelector(`[data-card-title="${gid}"]`);
        const dEl = card.querySelector(`[data-card-desc="${gid}"]`);
        if (tEl) tEl.textContent = (ov && ov.title) ? ov.title : GAME_META[gid].title;
        if (dEl) dEl.textContent = (ov && ov.desc) ? ov.desc : GAME_META[gid].desc;
      });
    }

    function renderFriends() {
      const pendingList = document.getElementById('pending-friends-list');
      const friendsList = document.getElementById('accepted-friends-list');
      const suggestedList = document.getElementById('suggested-players-list');

      document.getElementById('pending-count-badge').textContent = state.pendingRequests.length;
      document.getElementById('friends-count-badge').textContent = state.friends.length;

      pendingList.innerHTML = '';
      if (state.pendingRequests.length === 0) {
        pendingList.innerHTML = '<div class="p-4 rounded-2xl bg-slate-900/50 border border-white/5 text-xs text-slate-400">Нет исходящих заявок в ожидании.</div>';
      } else {
        state.pendingRequests.forEach((req) => {
          const card = document.createElement('div');
          card.className = 'p-3.5 rounded-2xl bg-slate-900/90 border border-amber-400/20 flex items-center justify-between gap-3';
          card.innerHTML = `<div class="flex items-center gap-3 min-w-0"><div class="w-10 h-10 rounded-xl bg-slate-800 flex items-center justify-center text-xl shrink-0">${req.avatar}</div><div class="min-w-0"><div class="text-sm font-bold text-white truncate">${escapeHtml(req.username)}</div><div class="text-[11px] text-amber-300">⏳ Ожидает принятия</div></div></div><button type="button" data-cancel-req="${req.id}" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-rose-500/20 hover:text-rose-300 border border-white/10 text-xs font-semibold text-slate-300 transition-colors shrink-0">Отменить</button>`;
          pendingList.appendChild(card);
        });
      }

      friendsList.innerHTML = '';
      if (state.friends.length === 0) {
        friendsList.innerHTML = '<div class="p-4 rounded-2xl bg-slate-900/50 border border-white/5 text-xs text-slate-400">У тебя пока нет друзей. Отправь заявку игрокам ниже!</div>';
      } else {
        state.friends.forEach((f) => {
          const card = document.createElement('div');
          card.className = 'p-3.5 rounded-2xl bg-slate-900/90 border border-emerald-400/20 flex items-center justify-between gap-3';
          card.innerHTML = `<div class="flex items-center gap-3 min-w-0"><div class="w-10 h-10 rounded-xl bg-slate-800 flex items-center justify-center text-xl shrink-0">${f.avatar}</div><div class="min-w-0"><div class="text-sm font-bold text-white truncate">${escapeHtml(f.username)}</div><div class="text-[11px] text-emerald-400">В друзьях • В сети</div></div></div><button type="button" data-remove-friend="${f.id}" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-rose-500/20 hover:text-rose-300 border border-white/10 text-xs font-semibold text-slate-300 transition-colors shrink-0">Удалить</button>`;
          friendsList.appendChild(card);
        });
      }

      suggestedList.innerHTML = '';
      DEFAULT_SUGGESTED.forEach((p) => {
        const isFriend = state.friends.some((f) => f.username.toLowerCase() === p.username.toLowerCase());
        const isPending = state.pendingRequests.some((r) => r.username.toLowerCase() === p.username.toLowerCase());
        const card = document.createElement('div');
        card.className = 'p-3.5 rounded-2xl bg-slate-900/90 border border-white/10 flex items-center justify-between gap-3';
        let actionHtml = isFriend
          ? '<span class="px-3 py-1.5 rounded-xl bg-emerald-500/15 text-emerald-300 text-xs font-bold shrink-0">В друзьях</span>'
          : isPending
          ? '<span class="px-3 py-1.5 rounded-xl bg-amber-500/15 text-amber-300 text-xs font-bold shrink-0">Ждём...</span>'
          : `<button type="button" data-add-suggested="${p.id}" class="px-3 py-1.5 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 text-xs font-bold transition-colors shrink-0">Добавить</button>`;
        card.innerHTML = `<div class="flex items-center gap-3 min-w-0"><div class="w-10 h-10 rounded-xl bg-slate-800 flex items-center justify-center text-xl shrink-0">${p.avatar}</div><div class="min-w-0"><div class="text-sm font-bold text-white truncate">${escapeHtml(p.username)}</div><div class="text-[11px] text-slate-400 truncate">${escapeHtml(p.bio)}</div></div></div>${actionHtml}`;
        suggestedList.appendChild(card);
      });
    }

    function switchTab(tab) {
      if (tab === 'admin' && !state.isAdmin) return;
      stopCurrentGameLoop();
      activeGame = null;
      currentTab = tab;
      state.currentTab = tab;
      saveState();

      ['games', 'shop', 'avatar', 'chat', 'play', 'profile', 'rewards', 'friends', 'admin'].forEach((v) => {
        document.getElementById(`view-${v}`).classList.toggle('hidden', v !== tab);
      });
      document.querySelectorAll('.nav-btn').forEach((btn) => {
        const isActive = btn.dataset.tab === tab;
        btn.classList.toggle('nav-active', isActive);
        btn.classList.toggle('text-slate-400', !isActive);
      });
      if (tab === 'profile') {
        const prof = getActiveProfile();
        document.getElementById('input-username').value = prof.username;
        document.getElementById('input-bio').value = prof.bio;
        selectedAvatar = prof.avatar;
        pendingCustomAvatar = prof.customAvatar;
      }
      renderAll();
    }

    document.querySelectorAll('.nav-btn').forEach((btn) => btn.addEventListener('click', () => switchTab(btn.dataset.tab)));
    document.getElementById('header-profile-btn').addEventListener('click', () => switchTab('profile'));
    document.getElementById('games-to-avatar-btn').addEventListener('click', () => switchTab('avatar'));
    document.getElementById('buy-admin-btn').addEventListener('click', () => {
      if (state.boughtAdmin || state.isAdmin) return;
      if (state.balance < 4500) {
        playCrashSound();
        showToast(`Не хватает ${4500 - state.balance} 🪙 для покупки Админки!`, 'warn');
        return;
      }
      state.balance -= 4500;
      state.boughtAdmin = true;
      state.isAdmin = true;
      state.adminRole = 'Покупка в магазине';
      state.rewardsHistory.push({ title: 'Покупка в магазине: Админка', amount: -4500, date: new Date().toISOString() });
      saveState();
      playCoinSound();
      if (window.confetti) confetti({ particleCount: 80, spread: 70, origin: { y: 0.7 } });
      showToast('👑 Поздравляем! Админка куплена и активирована!', 'success');
      switchTab('admin');
    });
    document.getElementById('quick-rewards-pill').addEventListener('click', () => switchTab('rewards'));
    document.getElementById('go-play-from-rewards').addEventListener('click', () => switchTab('games'));
    document.getElementById('admin-header-btn').addEventListener('click', () => switchTab('admin'));
    document.getElementById('sound-toggle-btn').addEventListener('click', () => { state.soundEnabled = !state.soundEnabled; saveState(); renderAll(); });

    // Profile Form & Anti-copy Username
    document.getElementById('avatar-upload').addEventListener('change', (e) => {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => { pendingCustomAvatar = reader.result; renderAll(); showToast('Фото загружено! Нажми «Сохранить профиль».', 'info'); };
      reader.readAsDataURL(file);
    });

    function isUsernameProtected(newUsername) {
      const lower = newUsername.trim().toLowerCase();
      if (state.isAdmin) return false;
      if (RESERVED_ADMIN_NAMES.some((w) => lower.includes(w))) return true;
      if (lower === state.adminProfile.username.toLowerCase()) return true;
      if (DEFAULT_SUGGESTED.some((p) => p.username.toLowerCase() === lower)) return true;
      if (state.friends.some((f) => f.username.toLowerCase() === lower)) return true;
      return false;
    }

    document.getElementById('profile-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const username = document.getElementById('input-username').value.trim();
      const bio = document.getElementById('input-bio').value.trim();
      if (!username) { showToast('Введи юзернейм!', 'warn'); return; }
      if (isUsernameProtected(username)) { playCrashSound(); showToast('Этот юзернейм занят или защищён от копирования!', 'warn'); return; }
      const target = getActiveProfile();
      target.username = username;
      target.bio = bio;
      target.avatar = selectedAvatar;
      target.customAvatar = pendingCustomAvatar;
      saveState();
      renderAll();
      playTone(660, 0.12, 'sine', 0.08);
      showToast('Профиль успешно сохранён!', 'success');
    });

    // Rewards & 5 Daily Quests
    const QUEST_TARGETS = {
      riddles5: { target: 5, reward: 15, title: 'Задание «Зоркий глаз»' },
      winRace1: { target: 1, reward: 20, title: 'Задание «Король асфальта»' },
      match3Win: { target: 1, reward: 12, title: 'Задание «Ювелир»' },
      chat2: { target: 2, reward: 8, title: 'Задание «Душа компании»' },
      friend1: { target: 1, reward: 10, title: 'Задание «Своя банда»' }
    };

    function advanceQuest(qid, amount = 1) {
      if (!state.questProgress) state.questProgress = {};
      if (!state.questClaimed) state.questClaimed = {};
      const cfg = QUEST_TARGETS[qid];
      if (!cfg || state.questClaimed[qid]) return;
      state.questProgress[qid] = Math.min(cfg.target, (state.questProgress[qid] || 0) + amount);
      if (state.questProgress[qid] >= cfg.target) {
        state.questClaimed[qid] = true;
        state.balance += cfg.reward;
        state.rewardsHistory.push({ title: cfg.title, amount: cfg.reward, date: new Date().toISOString() });
        playCoinSound();
        showToast(`🎯 ${cfg.title} выполнено! +${cfg.reward} 🪙`, 'reward');
      }
      saveState();
      renderAll();
    }

    function recordCompletedRun(gameName, bonusCoins = 0) {
      state.totalRuns += 1;
      state.dailyRuns += 1;
      if (bonusCoins > 0) {
        state.balance += bonusCoins;
        state.rewardsHistory.push({ title: `${gameName}`, amount: bonusCoins, date: new Date().toISOString() });
      }
      playCoinSound();
      if (state.dailyRuns >= 3 && !state.dailyClaimed) {
        state.dailyClaimed = true;
        state.balance += 10;
        state.rewardsHistory.push({ title: 'Ежедневный бонус: 3 заезда', amount: 10, date: new Date().toISOString() });
        saveState();
        renderAll();
        showToast('🎉 3 заезда сделаны! +10 монеток начислено на баланс!', 'reward');
        if (window.confetti) confetti({ particleCount: 70, spread: 65, origin: { y: 0.7 } });
      } else {
        saveState();
        renderAll();
        const left = Math.max(0, 3 - state.dailyRuns);
        if (left > 0) showToast(`🏁 Заезд засчитан! До приза 10 🪙 осталось: ${left}`, 'success');
      }
    }
    document.getElementById('reset-daily-btn').addEventListener('click', () => { state.dailyRuns = 0; state.dailyClaimed = false; state.questProgress = { riddles5: 0, winRace1: 0, match3Win: 0, chat2: 0, friend1: 0 }; state.questClaimed = { riddles5: false, winRace1: false, match3Win: false, chat2: false, friend1: false }; saveState(); renderAll(); showToast('Дневной прогресс сброшен.', 'info'); });

    // Friends
    function sendFriendRequest(playerObj) {
      const uname = playerObj.username.trim();
      if (!uname) return;
      if (uname.toLowerCase() === getActiveProfile().username.toLowerCase()) { showToast('Нельзя добавить самого себя!', 'warn'); return; }
      if (state.friends.some((f) => f.username.toLowerCase() === uname.toLowerCase())) { showToast(`${uname} уже в друзьях.`, 'info'); return; }
      if (state.pendingRequests.some((r) => r.username.toLowerCase() === uname.toLowerCase())) { showToast(`Заявка для ${uname} уже отправлена.`, 'info'); return; }
      const req = { id: 'req_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6), username: uname, avatar: playerObj.avatar || '🎮', bio: playerObj.bio || 'Игрок ZOOCLOC', sentAt: Date.now() };
      state.pendingRequests.push(req);
      saveState();
      renderAll();
      playTone(520, 0.1, 'sine', 0.07);
      showToast(`Заявка отправлена игроку ${uname}. Ждём, пока примет!`, 'info');
      advanceQuest('friend1', 1);
      if (playerObj.isSuggested) {
        setTimeout(() => {
          const idx = state.pendingRequests.findIndex((r) => r.id === req.id);
          if (idx !== -1) {
            const accepted = state.pendingRequests.splice(idx, 1)[0];
            state.friends.push({ id: accepted.id, username: accepted.username, avatar: accepted.avatar, bio: accepted.bio });
            saveState(); renderAll(); playCoinSound();
            showToast(`🤝 ${accepted.username} принял(а) твою заявку в друзья!`, 'success');
          }
        }, 10000);
      }
    }
    document.getElementById('add-friend-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const input = document.getElementById('friend-username-input');
      const val = input.value.trim();
      if (!val) { showToast('Введи юзернейм игрока!', 'warn'); return; }
      sendFriendRequest({ username: val, avatar: '🕹️', bio: 'Игрок' });
      input.value = '';
    });
    document.getElementById('view-friends').addEventListener('click', (e) => {
      const addBtn = e.target.closest('[data-add-suggested]');
      if (addBtn) { const p = DEFAULT_SUGGESTED.find((x) => x.id === addBtn.dataset.addSuggested); if (p) sendFriendRequest({ ...p, isSuggested: true }); return; }
      const cancelBtn = e.target.closest('[data-cancel-req]');
      if (cancelBtn) { state.pendingRequests = state.pendingRequests.filter((r) => r.id !== cancelBtn.dataset.cancelReq); saveState(); renderAll(); showToast('Заявка отменена.', 'info'); return; }
      const removeBtn = e.target.closest('[data-remove-friend]');
      if (removeBtn) { state.friends = state.friends.filter((f) => f.id !== removeBtn.dataset.removeFriend); saveState(); renderAll(); showToast('Удалён из друзей.', 'info'); }
    });

    // Chat + Word Replacement
    const BAD_WORDS = ['бля', 'бляд', 'блять', 'сука', 'сучк', 'хуй', 'хуе', 'хуя', 'пизд', 'еба', 'ебл', 'ёба', 'нах', 'пидор', 'пидар', 'гандон', 'мудак', 'мудил', 'дебил', 'идиот', 'дурак', 'тупой', 'лох', 'чмо', 'мразь', 'тварь', 'урод', 'кретин', 'даун', 'ублюд', 'сволоч', 'дерьм', 'говн'];
    const GOOD_REPLACEMENTS = { дурак: 'добряк', идиот: 'мечтатель', тупой: 'загадочный', лох: 'везунчик', дебил: 'гений', урод: 'красавчик', мразь: 'милашка', тварь: 'звёздочка', чмо: 'чемпион', даун: 'молодец', кретин: 'талант' };
    function sanitizeChatMessage(text) {
      let replaced = false, result = text;
      Object.entries(GOOD_REPLACEMENTS).forEach(([bad, good]) => {
        const re = new RegExp(bad + '[а-яё]*', 'gi');
        if (re.test(result)) { replaced = true; result = result.replace(re, good); }
      });
      BAD_WORDS.forEach((w) => {
        const re = new RegExp('[а-яёa-z0-9]*' + w + '[а-яёa-z0-9]*', 'gi');
        if (re.test(result)) { replaced = true; result = result.replace(re, 'цветочек'); }
      });
      return { text: result, replaced };
    }
    function updateMuteUI() {
      const now = Date.now(), banner = document.getElementById('chat-mute-banner'), timerEl = document.getElementById('chat-mute-timer'), input = document.getElementById('chat-input'), btn = document.getElementById('chat-send-btn');
      if (state.muteUntil && state.muteUntil > now) {
        const secLeft = Math.ceil((state.muteUntil - now) / 1000);
        const mm = String(Math.floor(secLeft / 60)).padStart(2, '0'), ss = String(secLeft % 60).padStart(2, '0');
        banner.classList.remove('hidden'); timerEl.textContent = `${mm}:${ss}`;
        input.disabled = true; btn.disabled = true; input.placeholder = `Чат заблокирован (мут ${mm}:${ss})...`;
      } else {
        if (state.muteUntil && state.muteUntil <= now) { state.muteUntil = 0; saveState(); }
        banner.classList.add('hidden'); input.disabled = false; btn.disabled = false; input.placeholder = 'Напиши сообщение в чат...';
      }
    }
    setInterval(() => { if (currentTab === 'chat' || (state.muteUntil && state.muteUntil > Date.now())) updateMuteUI(); }, 1000);

    function renderChat() {
      const box = document.getElementById('chat-messages');
      if (!box) return;
      box.innerHTML = '';
      (state.chatMessages || []).forEach((m) => {
        const row = document.createElement('div');
        const isMine = m.username === getActiveProfile().username;
        row.className = `flex items-start gap-2.5 ${isMine ? 'flex-row-reverse text-right' : ''}`;
        row.innerHTML = `<div class="w-8 h-8 rounded-xl bg-slate-800 border border-white/10 flex items-center justify-center text-base shrink-0">${m.avatar || '🎮'}</div><div class="max-w-[78%] rounded-2xl px-3.5 py-2 ${isMine ? 'bg-sky-500/20 border border-sky-400/30' : 'bg-slate-950 border border-white/10'}"><div class="flex items-center gap-1.5 ${isMine ? 'justify-end' : ''} text-[11px] mb-0.5"><span class="font-bold ${m.isAdmin ? 'text-rose-300' : 'text-sky-300'}">${escapeHtml(m.username)}</span>${m.isAdmin ? '<span class="px-1 rounded bg-rose-500/20 text-rose-300 text-[9px] font-extrabold">АДМИН</span>' : ''}<span class="text-slate-500">${m.time || ''}</span></div><div class="text-xs text-slate-100 break-words">${escapeHtml(m.text)}</div></div>`;
        box.appendChild(row);
      });
      box.scrollTop = box.scrollHeight;
      const onlineCount = (state.registeredPlayers || []).filter(p => p.online && !p.banned).length + 1;
      document.getElementById('chat-online-count').textContent = `${onlineCount} в чате`;
      updateMuteUI();
    }

    document.getElementById('chat-form').addEventListener('submit', (e) => {
      e.preventDefault();
      if (state.muteUntil && state.muteUntil > Date.now()) { updateMuteUI(); return; }
      const input = document.getElementById('chat-input');
      const text = input.value.trim();
      if (!text) return;
      const cleaned = sanitizeChatMessage(text);
      if (cleaned.replaced) showToast('✨ Запрещённые слова заменены на добрые!', 'info');
      const prof = getActiveProfile();
      state.chatMessages.push({ id: 'msg_' + Date.now(), username: prof.username, avatar: prof.avatar || '🏎️', isAdmin: state.isAdmin, text: cleaned.text, time: new Date().toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' }) });
      if (state.chatMessages.length > 60) state.chatMessages.shift();
      input.value = '';
      saveState(); renderChat(); playTone(580, 0.06, 'sine', 0.05);
      advanceQuest('chat2', 1);
    });

    // Admin Auth & Panel
    document.getElementById('owner-login-trigger').addEventListener('click', () => {
      if (state.isAdmin) { switchTab('admin'); return; }
      document.getElementById('admin-pin-input').value = '';
      document.getElementById('admin-modal').classList.remove('hidden');
    });
    document.getElementById('admin-modal-close').addEventListener('click', () => document.getElementById('admin-modal').classList.add('hidden'));
    document.getElementById('admin-pin-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const enteredPin = document.getElementById('admin-pin-input').value.trim();
      const adminRole = ADMIN_PINS[enteredPin];
      if (adminRole) {
        state.isAdmin = true; state.adminRole = adminRole; saveState();
        document.getElementById('admin-modal').classList.add('hidden');
        selectedAvatar = state.adminProfile.avatar; pendingCustomAvatar = state.adminProfile.customAvatar;
        playCoinSound(); showToast(`👑 Добро пожаловать в админку (${adminRole})!`, 'success'); switchTab('admin');
      } else { playCrashSound(); showToast('Неверный PIN-код!', 'warn'); }
    });
    document.getElementById('admin-logout-btn').addEventListener('click', () => {
      state.isAdmin = false; saveState();
      selectedAvatar = state.profile.avatar; pendingCustomAvatar = state.profile.customAvatar;
      showToast('Вы вышли из режима админа.', 'info'); switchTab('games');
    });

    let adminSubtab = 'settings', inspectedPlayerId = null;
    document.querySelectorAll('[data-admin-subtab]').forEach((btn) => {
      btn.addEventListener('click', () => {
        adminSubtab = btn.dataset.adminSubtab;
        document.getElementById('admin-panel-settings').classList.toggle('hidden', adminSubtab !== 'settings');
        document.getElementById('admin-panel-players').classList.toggle('hidden', adminSubtab !== 'players');
        document.querySelectorAll('[data-admin-subtab]').forEach((b) => {
          const active = b.dataset.adminSubtab === adminSubtab;
          b.className = active ? 'admin-subtab-btn py-2 rounded-xl bg-rose-500/20 text-rose-200 border border-rose-400/30 text-xs font-extrabold transition-colors' : 'admin-subtab-btn py-2 rounded-xl text-slate-400 hover:text-white text-xs font-extrabold transition-colors';
        });
        renderAdminPlayers();
      });
    });

    function getAllRegisteredPlayers() {
      const base = state.registeredPlayers || [];
      return [{ id: 'me_player', username: state.profile.username, avatar: state.profile.avatar, bio: state.profile.bio, coins: state.balance, runs: state.totalRuns, online: true, banned: false, muteUntil: state.muteUntil || 0, isSelf: true }, ...base];
    }

    function renderAdminPlayers() {
      if (!state.isAdmin) return;
      const all = getAllRegisteredPlayers();
      const online = all.filter((p) => p.online && !p.banned);
      document.getElementById('admin-players-tab-count').textContent = all.length;
      document.getElementById('admin-online-count').textContent = online.length;
      document.getElementById('admin-registered-count').textContent = all.length;
      const makeRow = (pl) => {
        const div = document.createElement('div');
        const isMuted = pl.muteUntil && pl.muteUntil > Date.now();
        div.className = `p-3 rounded-xl border flex flex-wrap items-center justify-between gap-2 ${pl.banned ? 'bg-rose-950/30 border-rose-500/30' : 'bg-slate-950 border-white/10'}`;
        div.innerHTML = `<div class="flex items-center gap-2.5 min-w-0"><div class="w-9 h-9 rounded-lg bg-slate-800 flex items-center justify-center text-lg shrink-0">${pl.avatar || '🎮'}</div><div class="min-w-0"><div class="flex items-center gap-1.5"><span class="text-xs font-bold text-white truncate">${escapeHtml(pl.username)}</span>${pl.online && !pl.banned ? '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>' : ''}${pl.banned ? '<span class="px-1.5 py-0.5 rounded bg-rose-500/25 text-rose-300 text-[9px] font-extrabold">БАН</span>' : ''}${isMuted ? '<span class="px-1.5 py-0.5 rounded bg-amber-500/25 text-amber-300 text-[9px] font-extrabold">МУТ</span>' : ''}</div><div class="text-[11px] text-amber-300 font-semibold">🪙 ${pl.coins}</div></div></div><div class="flex flex-wrap items-center gap-1.5"><button type="button" data-pl-profile="${pl.id}" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-sky-500/20 border border-white/10 text-[11px] font-bold text-sky-300">Профиль</button><button type="button" data-pl-coins="${pl.id}" class="px-2.5 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/30 text-[11px] font-bold text-amber-200">+25 🪙</button><button type="button" data-pl-mute="${pl.id}" class="px-2.5 py-1 rounded-lg ${isMuted ? 'bg-sky-500/20 hover:bg-sky-500/30 border-sky-400/30 text-sky-200' : 'bg-slate-800 hover:bg-amber-500/20 border-white/10 text-slate-300'} border text-[11px] font-bold">${isMuted ? 'Снять мут' : 'Мут 10м'}</button>${pl.isSelf ? '' : `<button type="button" data-pl-ban="${pl.id}" class="px-2.5 py-1 rounded-lg ${pl.banned ? 'bg-emerald-500/20 border-emerald-400/30 text-emerald-200' : 'bg-rose-500/20 border-rose-400/30 text-rose-200'} border text-[11px] font-bold">${pl.banned ? 'Разбанить' : 'Забанить'}</button>`}</div>`;
        return div;
      };
      const onlineEl = document.getElementById('admin-online-players-list'); onlineEl.innerHTML = '';
      if (online.length === 0) onlineEl.innerHTML = '<div class="text-xs text-slate-400">Нет игроков онлайн.</div>'; else online.forEach((pl) => onlineEl.appendChild(makeRow(pl)));
      const regEl = document.getElementById('admin-registered-players-list'); regEl.innerHTML = '';
      all.forEach((pl) => regEl.appendChild(makeRow(pl)));
    }

    function openPlayerProfileModal(plId) {
      const pl = getAllRegisteredPlayers().find((p) => p.id === plId);
      if (!pl) return;
      inspectedPlayerId = plId;
      document.getElementById('apm-avatar').textContent = pl.avatar || '🎮';
      document.getElementById('apm-username').textContent = pl.username;
      document.getElementById('apm-bio').textContent = pl.bio || 'Нет описания';
      document.getElementById('apm-coins').textContent = `${pl.coins} 🪙`;
      document.getElementById('apm-runs').textContent = pl.runs || 0;
      const badge = document.getElementById('apm-status-badge');
      badge.textContent = pl.banned ? 'ЗАБАНЕН' : pl.online ? 'ОНЛАЙН' : 'ОФФЛАЙН';
      badge.className = `px-2 py-0.5 rounded-full text-[10px] font-bold ${pl.banned ? 'bg-rose-500/20 text-rose-300' : pl.online ? 'bg-emerald-500/20 text-emerald-300' : 'bg-slate-800 text-slate-400'}`;
      const isMuted = pl.muteUntil && pl.muteUntil > Date.now();
      const muteBtn = document.getElementById('apm-mute-toggle');
      muteBtn.textContent = isMuted ? 'Убрать мут' : 'Мут 10м';
      muteBtn.className = isMuted ? 'flex-1 py-2 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-extrabold text-xs' : 'flex-1 py-2 rounded-xl bg-slate-800 hover:bg-amber-500/30 text-amber-200 border border-amber-400/30 font-extrabold text-xs';
      const banBtn = document.getElementById('apm-ban-toggle');
      banBtn.classList.toggle('hidden', !!pl.isSelf);
      banBtn.textContent = pl.banned ? 'Разбанить' : 'Забанить';
      banBtn.className = `flex-1 py-2 rounded-xl font-extrabold text-xs ${pl.banned ? 'bg-emerald-500 hover:bg-emerald-400 text-slate-950' : 'bg-rose-500 hover:bg-rose-400 text-white'}`;
      document.getElementById('admin-player-modal').classList.remove('hidden');
    }

    function giveCoinsToRegisteredPlayer(plId, amount) {
      if (plId === 'me_player') state.balance += amount;
      else { const pl = (state.registeredPlayers || []).find((p) => p.id === plId); if (pl) { pl.coins = (pl.coins || 0) + amount; state.playerCoins[pl.username] = pl.coins; } }
      saveState(); renderAll(); playCoinSound(); showToast(`Выдано +${amount} 🪙!`, 'reward');
    }
    function toggleMuteRegisteredPlayer(plId) {
      const now = Date.now();
      if (plId === 'me_player') {
        const isMuted = state.muteUntil && state.muteUntil > now;
        state.muteUntil = isMuted ? 0 : now + 10 * 60 * 1000;
        saveState(); renderAll(); showToast(isMuted ? '🔊 Мут снят!' : '🔇 Выдан мут на 10 минут!', isMuted ? 'success' : 'warn');
        return;
      }
      const pl = (state.registeredPlayers || []).find((p) => p.id === plId);
      if (!pl) return;
      const isMuted = pl.muteUntil && pl.muteUntil > now;
      pl.muteUntil = isMuted ? 0 : now + 10 * 60 * 1000;
      saveState(); renderAll(); showToast(isMuted ? `🔊 С игрока ${pl.username} снят мут!` : `🔇 Игроку ${pl.username} выдан мут на 10 минут!`, isMuted ? 'success' : 'warn');
    }
    function toggleBanRegisteredPlayer(plId) {
      const pl = (state.registeredPlayers || []).find((p) => p.id === plId);
      if (!pl) return;
      pl.banned = !pl.banned; saveState(); renderAll();
      showToast(pl.banned ? `🚫 ${pl.username} забанен!` : `✅ ${pl.username} разбанен!`, pl.banned ? 'warn' : 'success');
    }

    document.getElementById('admin-panel-players').addEventListener('click', (e) => {
      if (!state.isAdmin) return;
      const pBtn = e.target.closest('[data-pl-profile]'); if (pBtn) { openPlayerProfileModal(pBtn.dataset.plProfile); return; }
      const cBtn = e.target.closest('[data-pl-coins]'); if (cBtn) { giveCoinsToRegisteredPlayer(cBtn.dataset.plCoins, 25); return; }
      const mBtn = e.target.closest('[data-pl-mute]'); if (mBtn) { toggleMuteRegisteredPlayer(mBtn.dataset.plMute); return; }
      const bBtn = e.target.closest('[data-pl-ban]'); if (bBtn) toggleBanRegisteredPlayer(bBtn.dataset.plBan);
    });
    document.getElementById('admin-player-modal-close').addEventListener('click', () => document.getElementById('admin-player-modal').classList.add('hidden'));
    document.getElementById('apm-give-25').addEventListener('click', () => { if (inspectedPlayerId) { giveCoinsToRegisteredPlayer(inspectedPlayerId, 25); openPlayerProfileModal(inspectedPlayerId); } });
    document.getElementById('apm-mute-toggle').addEventListener('click', () => { if (inspectedPlayerId) { toggleMuteRegisteredPlayer(inspectedPlayerId); openPlayerProfileModal(inspectedPlayerId); } });
    document.getElementById('apm-ban-toggle').addEventListener('click', () => { if (inspectedPlayerId) { toggleBanRegisteredPlayer(inspectedPlayerId); openPlayerProfileModal(inspectedPlayerId); } });

    document.querySelectorAll('[data-admin-coins]').forEach((btn) => btn.addEventListener('click', () => {
      if (!state.isAdmin) return;
      const d = parseInt(btn.dataset.adminCoins, 10);
      state.balance = Math.max(0, state.balance + d);
      saveState(); renderAll(); playCoinSound(); showToast(`Баланс: ${d > 0 ? '+' : ''}${d} 🪙`, 'reward');
    }));
    document.getElementById('admin-complete-daily').addEventListener('click', () => {
      if (!state.isAdmin) return;
      state.dailyRuns = 3;
      if (!state.dailyClaimed) { state.dailyClaimed = true; state.balance += 10; state.rewardsHistory.push({ title: 'Админ: Ежедневный бонус', amount: 10, date: new Date().toISOString() }); }
      saveState(); renderAll(); playCoinSound(); showToast('Засчитано 3/3 заезда!', 'success');
    });
    document.getElementById('admin-pending-list').addEventListener('click', (e) => {
      const btn = e.target.closest('[data-admin-accept]');
      if (!btn || !state.isAdmin) return;
      const idx = state.pendingRequests.findIndex((r) => r.id === btn.dataset.adminAccept);
      if (idx !== -1) { const acc = state.pendingRequests.splice(idx, 1)[0]; state.friends.push({ id: acc.id, username: acc.username, avatar: acc.avatar, bio: acc.bio }); saveState(); renderAll(); showToast(`${acc.username} добавлен!`, 'success'); }
    });

    function populateAdminGameFields() {
      const gid = document.getElementById('admin-game-select').value;
      const ov = (state.siteConfig && state.siteConfig.gameOverrides && state.siteConfig.gameOverrides[gid]) || {};
      document.getElementById('admin-game-title-input').value = ov.title || GAME_META[gid].title;
      document.getElementById('admin-game-desc-input').value = ov.desc || GAME_META[gid].desc;
      document.getElementById('admin-game-visible').checked = ov.visible !== false;
    }

    function renderAdminPanel() {
      const container = document.getElementById('admin-pending-list');
      if (!state.isAdmin) { container.innerHTML = ''; return; }
      if (state.pendingRequests.length === 0) container.innerHTML = '<div class="text-slate-400">Нет ожидающих заявок в друзья.</div>';
      else {
        container.innerHTML = '';
        state.pendingRequests.forEach((req) => {
          const row = document.createElement('div');
          row.className = 'flex items-center justify-between p-2.5 rounded-xl bg-slate-950 border border-white/10';
          row.innerHTML = `<span class="text-slate-200 font-semibold">${escapeHtml(req.username)}</span><button type="button" data-admin-accept="${req.id}" class="px-3 py-1 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-[11px]">Принять сразу</button>`;
          container.appendChild(row);
        });
      }
      const cfg = state.siteConfig || defaultState.siteConfig;
      document.getElementById('admin-banner-enabled').checked = !!cfg.bannerEnabled;
      document.getElementById('admin-banner-title').value = cfg.bannerTitle || '';
      document.getElementById('admin-banner-body').value = cfg.bannerBody || '';
      document.getElementById('admin-bg-color').value = cfg.bgColor || '#0b0f19';
      document.getElementById('admin-accent-color').value = cfg.accentColor || '#38bdf8';
      populateAdminGameFields();
      renderAdminPlayers();
      const pbEl = document.getElementById('admin-player-balances');
      pbEl.innerHTML = '';
      Object.entries(state.playerCoins || {}).forEach(([uname, coins]) => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'px-2.5 py-1 rounded-lg bg-slate-950 border border-white/10 hover:border-amber-400/40 text-slate-200';
        chip.textContent = `${uname}: ${coins} 🪙`;
        chip.addEventListener('click', () => { document.getElementById('admin-target-player').value = uname; });
        pbEl.appendChild(chip);
      });
    }

    document.getElementById('admin-give-player-coins-form').addEventListener('submit', (e) => {
      e.preventDefault();
      if (!state.isAdmin) return;
      const uname = document.getElementById('admin-target-player').value.trim(), amount = parseInt(document.getElementById('admin-target-amount').value, 10);
      if (!uname || isNaN(amount) || amount <= 0) { showToast('Укажи ник и сумму!', 'warn'); return; }
      state.playerCoins[uname] = (state.playerCoins[uname] || 0) + amount;
      const reg = (state.registeredPlayers || []).find(p => p.username.toLowerCase() === uname.toLowerCase());
      if (reg) reg.coins = state.playerCoins[uname];
      saveState(); renderAll(); playCoinSound(); showToast(`Игроку ${uname} выдано +${amount} 🪙!`, 'reward');
    });
    document.getElementById('admin-home-text-form').addEventListener('submit', (e) => {
      e.preventDefault();
      if (!state.isAdmin) return;
      state.siteConfig.bannerEnabled = document.getElementById('admin-banner-enabled').checked;
      state.siteConfig.bannerTitle = document.getElementById('admin-banner-title').value.trim();
      state.siteConfig.bannerBody = document.getElementById('admin-banner-body').value.trim();
      saveState(); renderAll(); playTone(620, 0.1, 'sine', 0.07); showToast('Текст на главном экране обновлён!', 'success');
    });
    const THEME_PRESETS = { default: { bgColor: '#0b0f19', accentColor: '#38bdf8' }, cyber: { bgColor: '#130720', accentColor: '#f472b6' }, gold: { bgColor: '#161005', accentColor: '#facc15' }, emerald: { bgColor: '#04140e', accentColor: '#34d399' } };
    document.querySelectorAll('[data-theme-preset]').forEach((btn) => btn.addEventListener('click', () => {
      if (!state.isAdmin) return;
      const p = THEME_PRESETS[btn.dataset.themePreset];
      if (!p) return;
      state.siteConfig.bgColor = p.bgColor; state.siteConfig.accentColor = p.accentColor;
      saveState(); renderAll(); showToast('Тема применена!', 'success');
    }));
    document.getElementById('admin-bg-color').addEventListener('input', (e) => { if (state.isAdmin) { state.siteConfig.bgColor = e.target.value; saveState(); applySiteConfig(); } });
    document.getElementById('admin-accent-color').addEventListener('input', (e) => { if (state.isAdmin) { state.siteConfig.accentColor = e.target.value; saveState(); applySiteConfig(); } });
    document.getElementById('admin-game-select').addEventListener('change', populateAdminGameFields);
    document.getElementById('admin-edit-game-form').addEventListener('submit', (e) => {
      e.preventDefault();
      if (!state.isAdmin) return;
      const gid = document.getElementById('admin-game-select').value;
      state.siteConfig.gameOverrides[gid] = { title: document.getElementById('admin-game-title-input').value.trim() || GAME_META[gid].title, desc: document.getElementById('admin-game-desc-input').value.trim() || GAME_META[gid].desc, visible: document.getElementById('admin-game-visible').checked };
      saveState(); renderAll(); playTone(640, 0.1, 'sine', 0.07); showToast('Настройки игры сохранены!', 'success');
    });

    // ---------- GAMES ENGINE ----------
    const canvas = document.getElementById('game-canvas'), ctx = canvas.getContext('2d'), overlay = document.getElementById('game-overlay');
    let rafId = null, gameRunning = false, gameState = {};

    const GAME_META = {
      online_race: { title: 'Гонки 3D Онлайн: 10 уровней', emoji: '🏁', desc: 'Улучшенная физика, нитро-пламя, трафик и препятствия! Пройди все 10 уровней с друзьями и онлайн-игроками.', duration: 18 },
      riddles: { title: 'Загадки за монеты: 150 уровней', emoji: '🧩', desc: '150 уникальных уровней загадок! За каждый пройденный уровень получай +3 🪙 на баланс и +1 заезд.', duration: 0 },
      drift: { title: 'Неоновый Дрифт', emoji: '🏎️', desc: 'Уворачивайся от машин (← / → или кнопки внизу) и продержись 12 секунд до финиша!', duration: 12 },
      turbo: { title: 'Турбо Спринт', emoji: '⚡', desc: 'Жми «ГАЗ!» (или Пробел), когда стрелка в зелёной зоне, чтобы обогнать соперника!', duration: 12 },
      astro: { title: 'Космо-Трасса', emoji: '🚀', desc: 'Маневрируй между астероидами (← / →) и долети до гипер-врат за 12 секунд!', duration: 12 },
      match3: { title: '3 в ряд', emoji: '💎', desc: 'Собери 120 очков за 12 ходов!', duration: 0 }
    };

    function resizeCanvas() {
      const rect = canvas.parentElement.getBoundingClientRect();
      canvas.width = Math.max(300, Math.floor(rect.width));
      canvas.height = window.innerWidth >= 640 ? 420 : 380;
    }
    window.addEventListener('resize', () => { if (activeGame && ['drift', 'turbo', 'astro', 'online_race'].includes(activeGame)) resizeCanvas(); });
    function stopCurrentGameLoop() {
      if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
      gameRunning = false;
      const tEl = document.getElementById('three-race-container');
      const cEl = document.getElementById('game-canvas');
      if (tEl) tEl.classList.add('hidden');
      if (cEl) cEl.classList.remove('hidden');
    }

    function openGame(type) {
      activeGame = type;
      const meta = GAME_META[type];
      ['games', 'shop', 'avatar', 'chat', 'profile', 'rewards', 'friends', 'admin'].forEach((v) => document.getElementById(`view-${v}`).classList.add('hidden'));
      document.getElementById('view-play').classList.remove('hidden');
      document.getElementById('active-game-title').textContent = meta.title;
      document.getElementById('active-game-subtitle').textContent = `Заездов сегодня: ${Math.min(state.dailyRuns, 3)}/3`;

      const isCanvasGame = ['drift', 'turbo', 'astro'].includes(type);
      document.getElementById('canvas-wrapper').classList.toggle('hidden', !isCanvasGame);
      document.getElementById('match3-wrapper').classList.toggle('hidden', type !== 'match3');
      document.getElementById('riddles-wrapper').classList.toggle('hidden', type !== 'riddles');
      document.getElementById('online-lobby-wrapper').classList.toggle('hidden', type !== 'online_race');
      document.getElementById('online-race-hud').classList.add('hidden');
      document.getElementById('controls-lanes').classList.toggle('hidden', type !== 'drift' && type !== 'astro');
      document.getElementById('controls-turbo').classList.toggle('hidden', type !== 'turbo');

      if (isCanvasGame) {
        document.getElementById('game-hud-timer').textContent = `${meta.duration.toFixed(1)}s`;
        resizeCanvas();
        showOverlay(meta.emoji, 'Готов к заезду?', meta.desc, 'Начать заезд');
        ctx.fillStyle = type === 'astro' ? '#070414' : '#0f172a'; ctx.fillRect(0, 0, canvas.width, canvas.height);
      } else if (type === 'match3') {
        document.getElementById('game-hud-timer').textContent = '3 в ряд';
        initMatch3();
      } else if (type === 'riddles') {
        document.getElementById('game-hud-timer').textContent = '150 ур.';
        initRiddles();
      } else if (type === 'online_race') {
        document.getElementById('game-hud-timer').textContent = '10 ур.';
        initOnlineLobby();
      }
      if (window.lucide) lucide.createIcons();
    }

    function showOverlay(emoji, title, desc, btnText) {
      document.getElementById('overlay-emoji').textContent = emoji;
      document.getElementById('overlay-title').textContent = title;
      document.getElementById('overlay-desc').textContent = desc;
      document.getElementById('game-start-btn').textContent = btnText;
      overlay.classList.remove('hidden');
    }

    document.querySelectorAll('[data-open-game]').forEach((btn) => btn.addEventListener('click', () => openGame(btn.dataset.openGame)));
    document.getElementById('back-to-games-btn').addEventListener('click', () => switchTab('games'));
    document.getElementById('game-start-btn').addEventListener('click', () => { if (activeGame) startCanvasGame(activeGame); });

    // ---------- 30 LEVELS RIDDLES ----------
    const RIDDLES_150 = [{"q": "Ур. 1: Зимой и летом одним цветом. Что это?", "opts": ["Ёлка", "Берёза", "Снег", "Трава"], "ans": 0}, {"q": "Ур. 2: Без рук, без топоренка построена избёнка.", "opts": ["Улей", "Гнездо", "Нора", "Шалаш"], "ans": 1}, {"q": "Ур. 3: Что можно увидеть с закрытыми глазами?", "opts": ["Звёзды", "Сон", "Зеркало", "Туман"], "ans": 1}, {"q": "Ур. 4: Висит груша — нельзя скушать.", "opts": ["Яблоко", "Лампочка", "Колокол", "Фонарь"], "ans": 1}, {"q": "Ур. 5: Не лает, не кусает, а в дом не пускает.", "opts": ["Кот", "Замок", "Забор", "Ветер"], "ans": 1}, {"q": "Ур. 6: Сидит дед, во сто шуб одет. Кто раздевает — слёзы проливает.", "opts": ["Капуста", "Лук", "Чеснок", "Картошка"], "ans": 1}, {"q": "Ур. 7: Два конца, два кольца, посередине гвоздик.", "opts": ["Очки", "Ножницы", "Весы", "Колесо"], "ans": 1}, {"q": "Ур. 8: Течёт, течёт — не вытечет, бежит, бежит — не выбежит.", "opts": ["Ветер", "Река", "Облако", "Время"], "ans": 1}, {"q": "Ур. 9: Без окон, без дверей, полна горница людей.", "opts": ["Огурец", "Тыква", "Кокос", "Орех"], "ans": 0}, {"q": "Ур. 10: Кто ходит сидя?", "opts": ["Птица", "Шахматист", "Лягушка", "Краб"], "ans": 1}, {"q": "Ур. 11: Зимой на ветках яблоки! Скорей их собери!", "opts": ["Снегири", "Воробьи", "Совы", "Галки"], "ans": 0}, {"q": "Ур. 12: В воде не тонет и в огне не горит.", "opts": ["Камень", "Лёд", "Железо", "Дерево"], "ans": 1}, {"q": "Ур. 13: Что принадлежит тебе, но чаще используют другие?", "opts": ["Телефон", "Имя", "Ключи", "Одежда"], "ans": 1}, {"q": "Ур. 14: Чем больше из неё берёшь, тем больше она становится.", "opts": ["Яма", "Корзина", "Копилка", "Река"], "ans": 0}, {"q": "Ур. 15: Сто одёжек и все без застёжек.", "opts": ["Шуба", "Капуста", "Луковица", "Куртка"], "ans": 1}, {"q": "Ур. 16: Не огонь, а жжётся.", "opts": ["Солнце", "Крапива", "Лёд", "Перец"], "ans": 1}, {"q": "Ур. 17: Бежит без ног, летит без крыльев.", "opts": ["Туча", "Время", "Вода", "Дым"], "ans": 1}, {"q": "Ур. 18: Утром на 4 ногах, днём на 2, вечером на 3.", "opts": ["Медведь", "Человек", "Собака", "Робот"], "ans": 1}, {"q": "Ур. 19: Есть крылья, но не летает; ног нет, а догоняет.", "opts": ["Рыба", "Страус", "Пингвин", "Корабль"], "ans": 0}, {"q": "Ур. 20: Что всегда идёт вверх и никогда вниз?", "opts": ["Лифт", "Возраст", "Ракета", "Дым"], "ans": 1}, {"q": "Ур. 21: Говорит без языка, поёт без голоса.", "opts": ["Птица", "Радио", "Колокол", "Ветер"], "ans": 1}, {"q": "Ур. 22: Всё ест — не наедается, а попьёт — сразу умирает.", "opts": ["Огонь", "Земля", "Рыба", "Песок"], "ans": 0}, {"q": "Ур. 23: У кого есть шляпа без головы и нога без сапога?", "opts": ["Гриб", "Гвоздь", "Стол", "Зонт"], "ans": 0}, {"q": "Ур. 24: Что становится легче, если его надуть?", "opts": ["Шар", "Камень", "Губка", "Вода"], "ans": 0}, {"q": "Ур. 25: Какой месяц короче всех?", "opts": ["Февраль", "Май", "Июнь", "Март"], "ans": 1}, {"q": "Ур. 26: Сколько месяцев в году имеют 28 дней?", "opts": ["Один", "Два", "Шесть", "Все 12"], "ans": 3}, {"q": "Ур. 27: Что можно сломать, даже не дотрагиваясь?", "opts": ["Стекло", "Обещание", "Лёд", "Зеркало"], "ans": 1}, {"q": "Ур. 28: Какие часы показывают точное время только дважды в сутки?", "opts": ["Песочные", "Сломанные", "Солнечные", "Умные"], "ans": 1}, {"q": "Ур. 29: Что легче: килограмм ваты или килограмм железа?", "opts": ["Вата", "Железо", "Одинаково", "Неизвестно"], "ans": 2}, {"q": "Ур. 30: У отца Мэри есть 5 дочерей: Чача, Чече, Чичи, Чочо. Как зовут пятую?", "opts": ["Чучу", "Мэри", "Анна", "Лиза"], "ans": 1}, {"q": "Ур. 31: Что можно держать только в левой руке, но не в правой?", "opts": ["Правый локоть", "Ложку", "Мяч", "Телефон"], "ans": 0}, {"q": "Ур. 32: Что идёт, не двигаясь с места?", "opts": ["Поезд", "Время", "Собака", "Машина"], "ans": 1}, {"q": "Ур. 33: Что имеет зубы, но не может есть?", "opts": ["Пила", "Акула", "Лев", "Крокодил"], "ans": 0}, {"q": "Ур. 34: Что становится мокрым, когда сушит?", "opts": ["Солнце", "Полотенце", "Фен", "Ветер"], "ans": 1}, {"q": "Ур. 35: Что можно поймать, но нельзя бросить?", "opts": ["Мяч", "Простуду", "Рыбу", "Бумеранг"], "ans": 1}, {"q": "Ур. 36: У чего есть ключи, но нет замков?", "opts": ["Дверь", "Пианино", "Сейф", "Шкаф"], "ans": 1}, {"q": "Ур. 37: Что можно разбить одним словом?", "opts": ["Стекло", "Тишину", "Тарелку", "Лёд"], "ans": 1}, {"q": "Ур. 38: Что летает без крыльев и плачет без глаз?", "opts": ["Ветер", "Облако", "Самолёт", "Птица"], "ans": 1}, {"q": "Ур. 39: Какое колесо не крутится при правом повороте?", "opts": ["Запасное", "Переднее", "Заднее", "Левое"], "ans": 0}, {"q": "Ур. 40: Что имеет города, но не имеет домов; реки, но не имеет воды?", "opts": ["Глобус", "Карта", "Книга", "Картина"], "ans": 1}, {"q": "Ур. 41: Что растёт корнем вверх?", "opts": ["Сосна", "Сосулька", "Морковь", "Трава"], "ans": 1}, {"q": "Ур. 42: Кто говорит на всех языках мира?", "opts": ["Переводчик", "Эхо", "Диктор", "Попугай"], "ans": 1}, {"q": "Ур. 43: Что всегда перед нами, но мы его не видим?", "opts": ["Будущее", "Прошлое", "Зеркало", "Туман"], "ans": 0}, {"q": "Ур. 44: Что тем тяжелее нести, чем больше в нём дырок?", "opts": ["Сетка", "Сыр", "Губка", "Ведро"], "ans": 2}, {"q": "Ур. 45: Какой камень не найти в море?", "opts": ["Гальку", "Сухой", "Острый", "Белый"], "ans": 1}, {"q": "Ур. 46: Из какой посуды нельзя ничего съесть?", "opts": ["Из глубокой", "Из пустой", "Из разбитой", "Из бумажной"], "ans": 1}, {"q": "Ур. 47: Что не имеет длины, глубины, ширины и высоты, но можно измерить?", "opts": ["Время", "Воду", "Воздух", "Свет"], "ans": 0}, {"q": "Ур. 48: У какого слона нет хобота?", "opts": ["У африканского", "У шахматного", "У индийского", "У маленького"], "ans": 1}, {"q": "Ур. 49: Когда чёрной кошке проще всего пробраться в дом?", "opts": ["Ночью", "Когда открыта дверь", "Зимой", "В дождь"], "ans": 1}, {"q": "Ур. 50: Что можно приготовить, но нельзя съесть?", "opts": ["Уроки", "Суп", "Салат", "Пирог"], "ans": 0}, {"q": "Ур. 51: На какое дерево садится ворона во время проливного дождя?", "opts": ["На высокое", "На мокрое", "На берёзу", "На дуб"], "ans": 1}, {"q": "Ур. 52: Сколько яиц можно съесть натощак?", "opts": ["Десять", "Одно", "Два", "Пять"], "ans": 1}, {"q": "Ур. 53: Какое слово всегда пишется неправильно?", "opts": ["Неправильно", "Ошибка", "Сложно", "Задача"], "ans": 0}, {"q": "Ур. 54: Что с земли легко поднимешь, но далеко не закинешь?", "opts": ["Камень", "Пушинку", "Палку", "Мяч"], "ans": 1}, {"q": "Ур. 55: Где бывает конец света?", "opts": ["На полюсе", "В тёмной комнате", "В конце тоннеля", "На горизонте"], "ans": 1}, {"q": "Ур. 56: Какой рукой лучше размешивать чай?", "opts": ["Правой", "Левой", "Ложкой", "Обеими"], "ans": 2}, {"q": "Ур. 57: Что происходит с вороной после 3 лет жизни?", "opts": ["Улетает", "Идёт четвёртый год", "Меняет перья", "Спит"], "ans": 1}, {"q": "Ур. 58: Каким гребнем нельзя расчесаться?", "opts": ["Петушиным", "Деревянным", "Металлическим", "Пластиковым"], "ans": 0}, {"q": "Ур. 59: Под каким кустом сидит заяц во время дождя?", "opts": ["Под густым", "Под мокрым", "Под зелёным", "Под старым"], "ans": 1}, {"q": "Ур. 60: Сколько горошин войдёт в один стакан?", "opts": ["Сто", "Ни одной — они не ходят", "Пятьдесят", "Двадцать"], "ans": 1}, {"q": "Ур. 61: Кто носит дом на спине?", "opts": ["Черепаха", "Медведь", "Заяц", "Белка"], "ans": 0}, {"q": "Ур. 62: Белый, как снег, в чести у всех, в рот попал — там и пропал.", "opts": ["Соль", "Сахар", "Мука", "Лёд"], "ans": 1}, {"q": "Ур. 63: Не куст, а с листочками, не рубашка, а сшита.", "opts": ["Книга", "Тетрадь", "Газета", "Открытка"], "ans": 0}, {"q": "Ур. 64: Чёрный Ивашка, деревянная рубашка, где носом поведёт — там заметку кладёт.", "opts": ["Карандаш", "Ручка", "Кисть", "Фломастер"], "ans": 0}, {"q": "Ур. 65: Пушистая вата плывёт куда-то.", "opts": ["Туман", "Облако", "Снег", "Дым"], "ans": 1}, {"q": "Ур. 66: Красна девица сидит в темнице, а коса на улице.", "opts": ["Свёкла", "Морковь", "Редька", "Репа"], "ans": 1}, {"q": "Ур. 67: Сидит девица в темнице, а сама белая, как снег.", "opts": ["Редька", "Капуста", "Чеснок", "Лук"], "ans": 0}, {"q": "Ур. 68: Без крыльев летят, без ног бегут, без паруса плывут.", "opts": ["Облака", "Листья", "Птицы", "Лодки"], "ans": 0}, {"q": "Ур. 69: Кто зимой холодной бродит злой, голодный?", "opts": ["Лиса", "Волк", "Медведь", "Кабан"], "ans": 1}, {"q": "Ур. 70: Рыжая плутовка, хитрая да ловкая, в сарай попала, кур пересчитала.", "opts": ["Белка", "Лиса", "Рысь", "Куница"], "ans": 1}, {"q": "Ур. 71: Летом серый, зимой белый.", "opts": ["Волк", "Заяц", "Ёж", "Барсук"], "ans": 1}, {"q": "Ур. 72: Сам алый, сахарный, кафтан зелёный, бархатный.", "opts": ["Арбуз", "Яблоко", "Клубника", "Помидор"], "ans": 0}, {"q": "Ур. 73: Сердитый недотрога живёт в глуши лесной; иголок очень много, а нитки ни одной.", "opts": ["Дикобраз", "Ёж", "Кактус", "Ёлка"], "ans": 1}, {"q": "Ур. 74: По горам, по долам ходит шуба да кафтан.", "opts": ["Овца", "Коза", "Корова", "Лошадь"], "ans": 0}, {"q": "Ур. 75: Посреди двора стоит копна: спереди вилы, сзади метла.", "opts": ["Корова", "Лошадь", "Собака", "Олень"], "ans": 0}, {"q": "Ур. 76: Длинное ухо, комочек пуха, прыгает ловко, любит морковку.", "opts": ["Кролик", "Белка", "Хомяк", "Ёж"], "ans": 0}, {"q": "Ур. 77: Маленький шарик под лавкой шарит.", "opts": ["Мышь", "Кот", "Жук", "Ёж"], "ans": 0}, {"q": "Ур. 78: Гладишь — ласкается, дразнишь — кусается.", "opts": ["Кошка", "Собака", "Лиса", "Попугай"], "ans": 1}, {"q": "Ур. 79: Мохнатенькая, усатенькая, молоко пьёт, песенки поёт.", "opts": ["Кошка", "Собака", "Белка", "Сова"], "ans": 0}, {"q": "Ур. 80: Кто на себе свой лес носит?", "opts": ["Олень", "Лось", "Медведь", "Кабан"], "ans": 0}, {"q": "Ур. 81: Маленький рост, длинный хвост, серая шубка, острые зубки.", "opts": ["Мышка", "Крот", "Хомяк", "Белка"], "ans": 0}, {"q": "Ур. 82: С ветки на ветку прыгает ловко, орешки собирает.", "opts": ["Белка", "Куница", "Птица", "Обезьяна"], "ans": 0}, {"q": "Ур. 83: Днём спит, ночью летает, прохожих пугает.", "opts": ["Сова", "Ворона", "Орёл", "Голубь"], "ans": 0}, {"q": "Ур. 84: Трещит с самого утра: «Пор-р-ра! Пор-р-ра!» Кто это?", "opts": ["Сорока", "Ворона", "Синица", "Дятел"], "ans": 0}, {"q": "Ур. 85: Всё время стучит, деревья долбит, но их не калечит, а только лечит.", "opts": ["Дятел", "Сорока", "Скворец", "Синица"], "ans": 0}, {"q": "Ур. 86: Жёлтая грудка, в мороз у кормушки поёт звонко.", "opts": ["Синица", "Снегирь", "Воробей", "Щегол"], "ans": 0}, {"q": "Ур. 87: Не царь, а в короне, не всадник, а со шпорами.", "opts": ["Петух", "Павлин", "Орёл", "Гусь"], "ans": 0}, {"q": "Ур. 88: Квохчет, квохчет, детей созывает, всех под крыло собирает.", "opts": ["Курица", "Утка", "Гусыня", "Индейка"], "ans": 0}, {"q": "Ур. 89: Красные лапки, щиплет за пятки, беги без оглядки.", "opts": ["Гусь", "Утка", "Аист", "Лебедь"], "ans": 0}, {"q": "Ур. 90: Удивительный ребёнок! Только вышел из пелёнок, может плавать и нырять, как его родная мать.", "opts": ["Утёнок", "Цыплёнок", "Воробей", "Котёнок"], "ans": 0}, {"q": "Ур. 91: Над цветочком жужжит, сладкий мёд в улей носит.", "opts": ["Пчела", "Оса", "Шмель", "Муха"], "ans": 0}, {"q": "Ур. 92: Голубой аэропланчик сел на белый одуванчик.", "opts": ["Стрекоза", "Бабочка", "Муха", "Пчела"], "ans": 0}, {"q": "Ур. 93: Шевелились у цветка все четыре лепестка. Я сорвать его хотел — он вспорхнул и улетел.", "opts": ["Бабочка", "Стрекоза", "Пчела", "Жук"], "ans": 0}, {"q": "Ур. 94: Кто в лес идёт — на дом глядит; кто из лесу идёт — на лес глядит?", "opts": ["Топор", "Грибник", "Корзина", "Ружьё"], "ans": 0}, {"q": "Ур. 95: Стоит Антошка на одной ножке.", "opts": ["Гриб", "Фонарь", "Стол", "Цветок"], "ans": 0}, {"q": "Ур. 96: Я капелька лета на тоненькой ножке, плетут для меня кузовки и лукошки.", "opts": ["Земляника", "Малина", "Черника", "Клюква"], "ans": 0}, {"q": "Ур. 97: Белые горошки на зелёной ножке.", "opts": ["Ландыш", "Ромашка", "Подснежник", "Колокольчик"], "ans": 0}, {"q": "Ур. 98: Белая корзинка, золотое донце, в ней лежит росинка и сверкает солнце.", "opts": ["Ромашка", "Одуванчик", "Лилия", "Тюльпан"], "ans": 0}, {"q": "Ур. 99: На зелёной хрупкой ножке вырос шарик у дорожки.", "opts": ["Одуванчик", "Мак", "Василёк", "Пион"], "ans": 0}, {"q": "Ур. 100: Сидит на грядке вся в заплатках; кто ни взглянет — всяк заплачет.", "opts": ["Лук", "Капуста", "Чеснок", "Редис"], "ans": 0}, {"q": "Ур. 101: Кругла, а не месяц, желта, а не масло, сладка, а не сахар, с хвостом, а не мышь.", "opts": ["Репа", "Морковь", "Свёкла", "Тыква"], "ans": 0}, {"q": "Ур. 102: И зелен, и густ на грядке вырос куст. Покопай немножко — под кустом...", "opts": ["Картошка", "Морковка", "Свёкла", "Редиска"], "ans": 0}, {"q": "Ур. 103: Растут на грядке зелёные ветки, а на них красные детки.", "opts": ["Помидоры", "Огурцы", "Перцы", "Баклажаны"], "ans": 0}, {"q": "Ур. 104: Маленький, горький, луку брат.", "opts": ["Чеснок", "Перец", "Хрен", "Редис"], "ans": 0}, {"q": "Ур. 105: Золотое решето чёрных домиков полно.", "opts": ["Подсолнух", "Кукуруза", "Арбуз", "Тыква"], "ans": 0}, {"q": "Ур. 106: Он на солнце греет бок, дарит нам томатный сок.", "opts": ["Помидор", "Перец", "Арбуз", "Апельсин"], "ans": 0}, {"q": "Ур. 107: На бахче у нас растёт, как разрежешь — сок течёт, сладкий, красный и большой.", "opts": ["Арбуз", "Дыня", "Тыква", "Кабачок"], "ans": 0}, {"q": "Ур. 108: Жёлтый цитрус, кислый вкус — в чай добавим, не боюсь!", "opts": ["Лимон", "Апельсин", "Мандарин", "Банан"], "ans": 0}, {"q": "Ур. 109: С оранжевой кожей, на солнышко похожий, внутри на дольки делён.", "opts": ["Апельсин", "Лимон", "Персик", "Абрикос"], "ans": 0}, {"q": "Ур. 110: Пьёт бензин, как молоко, может бегать далеко, возит грузы и людей.", "opts": ["Машина", "Велосипед", "Лошадь", "Самокат"], "ans": 0}, {"q": "Ур. 111: Что за чудо — длинный дом! Пассажиров много в нём. Носит обувь из резины и питается бензином.", "opts": ["Автобус", "Трамвай", "Поезд", "Метро"], "ans": 0}, {"q": "Ур. 112: Железные избушки прицеплены друг к дружке. Одна из них с трубой везёт всех за собой.", "opts": ["Поезд", "Трамвай", "Автобус", "Троллейбус"], "ans": 0}, {"q": "Ур. 113: Без разгона ввысь взлетает, стрекозу напоминает.", "opts": ["Вертолёт", "Самолёт", "Ракета", "Дирижабль"], "ans": 0}, {"q": "Ур. 114: Смело в небе проплывает, обгоняя птиц полёт. Человек им управляет. Что такое?", "opts": ["Самолёт", "Ракета", "Воздушный шар", "Дельтаплан"], "ans": 0}, {"q": "Ур. 115: Бежит конь вороной, много тащит за собой по стальным рельсам.", "opts": ["Паровоз", "Троллейбус", "Автомобиль", "Трактор"], "ans": 0}, {"q": "Ур. 116: Я мчусь, держась за провода, не заблужусь я никогда.", "opts": ["Троллейбус", "Автобус", "Такси", "Мотоцикл"], "ans": 0}, {"q": "Ур. 117: Есть педали и два колеса, кручу их ногами — лечу в небеса!", "opts": ["Велосипед", "Самокат", "Скейт", "Ролики"], "ans": 0}, {"q": "Ур. 118: Под землёй бежит, гудит, всех до станции домчит.", "opts": ["Метро", "Трамвай", "Электричка", "Монорельс"], "ans": 0}, {"q": "Ур. 119: Плывёт по морю великан, гудит в тумане капитан.", "opts": ["Корабль", "Лодка", "Яхта", "Катер"], "ans": 0}, {"q": "Ур. 120: Глазами не увидишь, руками не возьмёшь, а без него не проживёшь.", "opts": ["Воздух", "Свет", "Звук", "Тепло"], "ans": 0}, {"q": "Ур. 121: Шумит он в поле и в саду, а в дом не попадёт.", "opts": ["Ветер", "Дождь", "Гром", "Снег"], "ans": 0}, {"q": "Ур. 122: Мочит поле, лес и луг, город, дом и всё вокруг!", "opts": ["Дождь", "Снег", "Град", "Туман"], "ans": 0}, {"q": "Ур. 123: Он пушистый, серебристый, белый, чистый, с неба падает зимой.", "opts": ["Снег", "Дождь", "Туман", "Иней"], "ans": 0}, {"q": "Ур. 124: Разноцветное коромысло над рекою повисло.", "opts": ["Радуга", "Облако", "Молния", "Закат"], "ans": 0}, {"q": "Ур. 125: Сверкнула ярко в небе синем, за ней раскат прогремел сильный.", "opts": ["Молния", "Радуга", "Комета", "Фейерверк"], "ans": 0}, {"q": "Ур. 126: Ты за ним — оно от тебя, ты от него — оно за тобой.", "opts": ["Тень", "Эхо", "Зеркало", "Ветер"], "ans": 0}, {"q": "Ур. 127: Ночью на небе их тысячи горят, словно бриллианты на нас глядят.", "opts": ["Звёзды", "Облака", "Самолёты", "Птицы"], "ans": 0}, {"q": "Ур. 128: Встаёт рано, ложится поздно, светит ярко, греет жарко.", "opts": ["Солнце", "Луна", "Фонарь", "Костёр"], "ans": 0}, {"q": "Ур. 129: Ночью по небу гуляет, тускло землю освещает, то кругла, то серп.", "opts": ["Луна", "Звезда", "Комета", "Планета"], "ans": 0}, {"q": "Ур. 130: Четыре брата под одной крышей стоят.", "opts": ["Стол", "Стул", "Шкаф", "Диван"], "ans": 0}, {"q": "Ур. 131: На четырёх ногах стою, ходить же вовсе не могу. На мне ты станешь отдыхать.", "opts": ["Стул", "Стол", "Шкаф", "Полка"], "ans": 0}, {"q": "Ур. 132: И в мороз, и в холода в нём хранится вся еда.", "opts": ["Холодильник", "Шкаф", "Стол", "Духовка"], "ans": 0}, {"q": "Ур. 133: На стене висит, болтает, всё, что в мире происходит, показывает.", "opts": ["Телевизор", "Зеркало", "Картина", "Часы"], "ans": 0}, {"q": "Ур. 134: Весь мир в коробочке лежит: нажмёшь кнопку — позвонит.", "opts": ["Телефон", "Плеер", "Пульт", "Калькулятор"], "ans": 0}, {"q": "Ур. 135: Пыль увидит — заворчит, завертится, зашумит и всю пыль проглотит вмиг!", "opts": ["Пылесос", "Веник", "Швабра", "Фен"], "ans": 0}, {"q": "Ур. 136: То назад, то вперёд ходит, бродит пароход. Остановишь — горе: продырявит море.", "opts": ["Утюг", "Фен", "Миксер", "Тостер"], "ans": 0}, {"q": "Ур. 137: Из горячего колодца через нос водица льётся.", "opts": ["Чайник", "Кран", "Кувшин", "Термос"], "ans": 0}, {"q": "Ур. 138: Я стеклянный, я прохладный, отражаю всё исправно.", "opts": ["Зеркало", "Окно", "Очки", "Экран"], "ans": 0}, {"q": "Ур. 139: Зимой в доме тепло дарит, дровами или газом жарит.", "opts": ["Печь", "Холодильник", "Вентилятор", "Кондиционер"], "ans": 0}, {"q": "Ур. 140: По чёрному полю белый заяц пробежал — след оставил.", "opts": ["Мел на доске", "Ручка", "Карандаш", "Краска"], "ans": 0}, {"q": "Ур. 141: Если ты его отточишь — нарисуешь всё, что хочешь!", "opts": ["Карандаш", "Линейка", "Ластик", "Циркуль"], "ans": 0}, {"q": "Ур. 142: Я люблю прямоту, я сама прямая. Сделать ровную черту всем я помогаю.", "opts": ["Линейка", "Тетрадь", "Ручка", "Кисть"], "ans": 0}, {"q": "Ур. 143: Если ей работу дашь — зря трудился карандаш.", "opts": ["Резинка (ластик)", "Точилка", "Линейка", "Ножницы"], "ans": 0}, {"q": "Ур. 144: В этой узенькой коробке ты найдёшь карандаши, ручки, перья, скрепки, кнопки.", "opts": ["Пенал", "Рюкзак", "Тетрадь", "Папка"], "ans": 0}, {"q": "Ур. 145: Новый дом несу в руке, дверца дома на замке. Тут живут бумажные, все такие важные.", "opts": ["Портфель", "Пенал", "Шкаф", "Чемодан"], "ans": 0}, {"q": "Ур. 146: На ноге стоит одной, крутит-вертит головой. Нам показывает страны, реки, горы, океаны.", "opts": ["Глобус", "Компас", "Карта", "Часы"], "ans": 0}, {"q": "Ур. 147: В кармане лежит, север-юг сторожит.", "opts": ["Компас", "Термометр", "Фонарик", "Часы"], "ans": 0}, {"q": "Ур. 148: Сколько букв в слове «ZOOCLOC»?", "opts": ["Пять", "Шесть", "Семь", "Восемь"], "ans": 2}, {"q": "Ур. 149: У квадрата 4 угла. Если отпилить один угол, сколько углов останется?", "opts": ["Три", "Четыре", "Пять", "Шесть"], "ans": 2}, {"q": "Ур. 150: Шли 7 братьев, у каждого по одной сестре. Сколько всего человек?", "opts": ["Восемь", "Четырнадцать", "Семь", "Девять"], "ans": 0}];

    let ridLocked = false;
    function initRiddles() {
      ridLocked = false;
      ridPage = Math.floor(((state.riddleCurrentLevel || 1) - 1) / 30);
      renderRiddleLevel();
    }

    let ridPage = 0;
    function renderRiddleLevel() {
      const lvl = Math.max(1, Math.min(150, state.riddleCurrentLevel || 1));
      if (ridPage < 0 || ridPage > 4) ridPage = Math.floor((lvl - 1) / 30);
      const item = RIDDLES_150[lvl - 1];
      const solved = state.riddleSolvedLevels || [];
      document.getElementById('rid-level-num').textContent = lvl;
      document.getElementById('rid-solved-count').textContent = solved.length;
      document.getElementById('rid-question').textContent = item.q;
      document.getElementById('rid-feedback').classList.add('hidden');

      const pagesEl = document.getElementById('rid-pages-tabs');
      pagesEl.innerHTML = '';
      for (let pIdx = 0; pIdx < 5; pIdx++) {
        const from = pIdx * 30 + 1, to = (pIdx + 1) * 30;
        const pBtn = document.createElement('button');
        pBtn.type = 'button';
        pBtn.className = `px-2.5 py-1 rounded-lg text-[11px] font-bold border transition-colors ${ridPage === pIdx ? 'bg-sky-500 text-slate-950 border-sky-300' : 'bg-slate-950 text-slate-400 border-white/10 hover:border-white/25'}`;
        pBtn.textContent = `${from}–${to}`;
        pBtn.addEventListener('click', () => { ridPage = pIdx; renderRiddleLevel(); });
        pagesEl.appendChild(pBtn);
      }

      const grid = document.getElementById('rid-levels-grid');
      grid.innerHTML = '';
      const startL = ridPage * 30 + 1, endL = (ridPage + 1) * 30;
      for (let i = startL; i <= endL; i++) {
        const b = document.createElement('button');
        b.type = 'button';
        const isDone = solved.includes(i);
        const isCurr = i === lvl;
        b.className = `py-1 rounded-lg text-[11px] font-bold border transition-colors ${isCurr ? 'bg-amber-500 text-slate-950 border-amber-300' : isDone ? 'bg-emerald-500/20 text-emerald-300 border-emerald-400/30' : 'bg-slate-950 text-slate-400 border-white/10 hover:border-white/25'}`;
        b.textContent = i;
        b.addEventListener('click', () => { state.riddleCurrentLevel = i; ridPage = Math.floor((i - 1) / 30); saveState(); renderRiddleLevel(); });
        grid.appendChild(b);
      }

      const optsEl = document.getElementById('rid-options');
      optsEl.innerHTML = '';
      item.opts.forEach((opt, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'p-3.5 rounded-xl bg-slate-950 hover:bg-slate-800 border border-white/15 text-sm font-bold text-white text-left transition-colors';
        btn.textContent = opt;
        btn.addEventListener('click', () => handleRiddleAnswer(lvl, i, btn));
        optsEl.appendChild(btn);
      });
    }

    function handleRiddleAnswer(lvl, choiceIdx, btnEl) {
      if (ridLocked) return;
      ridLocked = true;
      const item = RIDDLES_150[lvl - 1];
      const fb = document.getElementById('rid-feedback');
      fb.classList.remove('hidden');

      if (choiceIdx === item.ans) {
        const solved = state.riddleSolvedLevels || [];
        const firstTime = !solved.includes(lvl);
        if (firstTime) {
          solved.push(lvl);
          state.riddleSolvedLevels = solved;
          recordCompletedRun(`Загадки: Уровень ${lvl}`, 3);
        } else {
          recordCompletedRun(`Загадки: Уровень ${lvl} (повтор)`, 1);
        }
        advanceQuest('riddles5', 1);
        btnEl.classList.add('border-emerald-400', 'bg-emerald-500/20');
        fb.className = 'text-center text-sm font-bold py-2 text-emerald-400';
        fb.textContent = firstTime ? `✅ Уровень ${lvl} пройден! +3 🪙 на баланс!` : `✅ Верно! +1 🪙 за повтор`;
        setTimeout(() => {
          ridLocked = false;
          state.riddleCurrentLevel = lvl < 150 ? lvl + 1 : 1; ridPage = Math.floor((state.riddleCurrentLevel - 1) / 30);
          saveState();
          renderRiddleLevel();
        }, 1100);
      } else {
        playCrashSound();
        btnEl.classList.add('border-rose-400', 'bg-rose-500/20');
        fb.className = 'text-center text-sm font-bold py-2 text-rose-400';
        fb.textContent = '❌ Неверно! Попробуй другой вариант.';
        setTimeout(() => { ridLocked = false; }, 600);
      }
    }

    // ---------- 10 LEVELS IMPROVED ONLINE RACING ----------
    const RACE_LEVELS = [
      { lvl: 1, name: 'Ночной Старт', dist: 700, aiSpeed: 44, trafficRate: 1.6, reward1: 12 },
      { lvl: 2, name: 'Неоновый Проспект', dist: 800, aiSpeed: 48, trafficRate: 1.4, reward1: 13 },
      { lvl: 3, name: 'Скоростная Эстакада', dist: 900, aiSpeed: 52, trafficRate: 1.25, reward1: 14 },
      { lvl: 4, name: 'Турбо Мост', dist: 1000, aiSpeed: 55, trafficRate: 1.1, reward1: 15 },
      { lvl: 5, name: 'Кибер-Тоннель', dist: 1100, aiSpeed: 58, trafficRate: 1.0, reward1: 17 },
      { lvl: 6, name: 'Дрифт Каньон', dist: 1200, aiSpeed: 61, trafficRate: 0.9, reward1: 18 },
      { lvl: 7, name: 'Мегаполис 2099', dist: 1300, aiSpeed: 64, trafficRate: 0.82, reward1: 20 },
      { lvl: 8, name: 'Штормовая Трасса', dist: 1400, aiSpeed: 67, trafficRate: 0.75, reward1: 22 },
      { lvl: 9, name: 'Гран-При Мастеров', dist: 1500, aiSpeed: 70, trafficRate: 0.68, reward1: 24 },
      { lvl: 10, name: 'Финал Чемпионов', dist: 1650, aiSpeed: 74, trafficRate: 0.6, reward1: 25 }
    ];

    let selectedRaceLevel = 1;
    let lobbyRacers = [];
    let orState = null;

    function initOnlineLobby() {
      selectedRaceLevel = Math.min(10, state.raceUnlockedLevel || 1);
      const prof = getActiveProfile();
      lobbyRacers = [
        { id: 'me', username: prof.username, avatar: prof.avatar, color: '#38bdf8', isMe: true, tag: 'Ты' },
        { id: 'bot1', username: 'AlexDrift', avatar: '🏎️', color: '#f43f5e', isMe: false, tag: 'Онлайн' },
        { id: 'bot2', username: 'NeonFox', avatar: '🦊', color: '#a855f7', isMe: false, tag: 'Онлайн' },
        { id: 'bot3', username: 'TurboMax', avatar: '⚡', color: '#10b981', isMe: false, tag: 'Онлайн' }
      ];
      renderOnlineLobby();
    }

    function renderOnlineLobby() {
      const lvlCfg = RACE_LEVELS[selectedRaceLevel - 1];
      document.getElementById('or-lobby-level').textContent = selectedRaceLevel;
      document.getElementById('or-level-name').textContent = lvlCfg.name;
      document.getElementById('or-level-reward').textContent = `Приз за 1 место: +${lvlCfg.reward1} 🪙`;
      document.getElementById('or-btn-level').textContent = selectedRaceLevel;

      const grid = document.getElementById('or-levels-grid');
      grid.innerHTML = '';
      const completed = state.raceCompletedLevels || [];
      for (let i = 1; i <= 10; i++) {
        const b = document.createElement('button');
        b.type = 'button';
        const isDone = completed.includes(i);
        const isSel = i === selectedRaceLevel;
        b.className = `py-1.5 rounded-xl text-xs font-extrabold border transition-colors ${isSel ? 'bg-sky-500 text-slate-950 border-sky-300' : isDone ? 'bg-emerald-500/20 text-emerald-300 border-emerald-400/30' : 'bg-slate-950 text-slate-300 border-white/10 hover:border-white/30'}`;
        b.textContent = isDone ? `${i}✓` : `${i}`;
        b.addEventListener('click', () => { selectedRaceLevel = i; renderOnlineLobby(); });
        grid.appendChild(b);
      }

      document.getElementById('lobby-players-count').textContent = `${lobbyRacers.length} / 6`;
      const roster = document.getElementById('lobby-roster');
      roster.innerHTML = '';
      lobbyRacers.forEach((r) => {
        const card = document.createElement('div');
        card.className = `p-3 rounded-xl border flex items-center justify-between gap-2 ${r.isMe ? 'bg-sky-500/15 border-sky-400/40' : 'bg-slate-950 border-white/10'}`;
        card.innerHTML = `<div class="flex items-center gap-2.5 min-w-0"><div class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-lg shrink-0">${r.avatar}</div><div class="min-w-0"><div class="text-xs font-bold text-white truncate">${escapeHtml(r.username)}</div><div class="text-[10px] font-semibold" style="color:${r.color}">${r.tag}</div></div></div><span class="w-3 h-3 rounded-full shrink-0" style="background:${r.color}"></span>`;
        roster.appendChild(card);
      });

      const inviteEl = document.getElementById('lobby-invite-friends');
      inviteEl.innerHTML = '';
      const invitePool = [...state.friends, ...DEFAULT_SUGGESTED.filter(p => !lobbyRacers.some(r => r.username === p.username))];
      if (invitePool.length === 0) inviteEl.innerHTML = '<span class="text-xs text-slate-400">Все игроки уже в комнате!</span>';
      else {
        invitePool.slice(0, 6).forEach((f) => {
          const already = lobbyRacers.some((r) => r.username === f.username);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.disabled = already || lobbyRacers.length >= 6;
          btn.className = `px-3 py-1.5 rounded-xl text-xs font-bold border transition-colors ${already ? 'bg-emerald-500/15 border-emerald-400/30 text-emerald-300' : 'bg-slate-950 hover:bg-sky-500/20 border-white/15 text-slate-200'}`;
          btn.textContent = already ? `✓ ${f.username} в комнате` : `+ Пригласить ${f.username}`;
          btn.addEventListener('click', () => {
            if (lobbyRacers.length >= 6 || already) return;
            const colors = ['#f59e0b', '#ec4899', '#22d3ee'];
            lobbyRacers.push({ id: 'fr_' + f.username, username: f.username, avatar: f.avatar || '🎮', color: colors[lobbyRacers.length % colors.length], isMe: false, tag: state.friends.some(fr => fr.username === f.username) ? 'Друг' : 'Онлайн' });
            playTone(620, 0.08, 'sine', 0.07); showToast(`${f.username} зашёл в гонку!`, 'success'); renderOnlineLobby();
          });
          inviteEl.appendChild(btn);
        });
      }
    }

    document.querySelectorAll('[data-track-select]').forEach((btn) => btn.addEventListener('click', () => {
      state.onlineTrack = btn.dataset.trackSelect; saveState();
      document.querySelectorAll('[data-track-select]').forEach((b) => {
        b.className = b.dataset.trackSelect === state.onlineTrack ? 'track-btn px-3 py-1.5 rounded-xl bg-sky-500/20 border border-sky-400 text-sky-200 text-xs font-bold' : 'track-btn px-3 py-1.5 rounded-xl bg-slate-950 border border-white/10 text-slate-300 text-xs font-bold';
      });
    }));

    document.getElementById('start-online-race-btn').addEventListener('click', startOnlineRace);

    let threeScene = null, threeCamera = null, threeRenderer = null;
    let threeCars = [], threePads = [], threeBarriers = [], threeRoadLines = [], threeFinishArch = null;

    function build3DCarMesh(colorHex, isMe) {
      const group = new THREE.Group();
      // Chassis
      const bodyGeo = new THREE.BoxGeometry(1.4, 0.55, 2.8);
      const bodyMat = new THREE.MeshPhongMaterial({ color: colorHex, shininess: 90 });
      const body = new THREE.Mesh(bodyGeo, bodyMat);
      body.position.y = 0.45;
      group.add(body);

      // Cabin
      const cabGeo = new THREE.BoxGeometry(1.05, 0.42, 1.35);
      const cabMat = new THREE.MeshPhongMaterial({ color: 0x0f172a, shininess: 100 });
      const cab = new THREE.Mesh(cabGeo, cabMat);
      cab.position.set(0, 0.88, -0.1);
      group.add(cab);

      // Spoiler
      const spGeo = new THREE.BoxGeometry(1.45, 0.1, 0.3);
      const spMat = new THREE.MeshPhongMaterial({ color: 0x111827 });
      const sp = new THREE.Mesh(spGeo, spMat);
      sp.position.set(0, 0.86, 1.25);
      group.add(sp);

      // 4 Wheels
      const wGeo = new THREE.CylinderGeometry(0.32, 0.32, 0.24, 12);
      const wMat = new THREE.MeshLambertMaterial({ color: 0x090d16 });
      [[-0.72, 0.32, -0.85], [0.72, 0.32, -0.85], [-0.72, 0.32, 0.85], [0.72, 0.32, 0.85]].forEach(([wx, wy, wz]) => {
        const w = new THREE.Mesh(wGeo, wMat);
        w.rotation.z = Math.PI / 2;
        w.position.set(wx, wy, wz);
        group.add(w);
      });

      // Nitro Flame cone
      const flameGeo = new THREE.ConeGeometry(0.26, 0.95, 8);
      const flameMat = new THREE.MeshBasicMaterial({ color: 0xf59e0b });
      const flame = new THREE.Mesh(flameGeo, flameMat);
      flame.rotation.x = Math.PI / 2;
      flame.position.set(0, 0.42, 1.85);
      flame.visible = false;
      group.add(flame);
      group.userData.flame = flame;

      // Headlights
      const hlGeo = new THREE.BoxGeometry(0.28, 0.14, 0.08);
      const hlMat = new THREE.MeshBasicMaterial({ color: isMe ? 0xfef08a : 0xe2e8f0 });
      [-0.45, 0.45].forEach((hx) => {
        const hl = new THREE.Mesh(hlGeo, hlMat);
        hl.position.set(hx, 0.48, -1.42);
        group.add(hl);
      });

      return group;
    }

    function initThreeRaceScene(lvlCfg, racers) {
      const container = document.getElementById('three-race-container');
      container.innerHTML = '';
      const w = container.clientWidth || 360;
      const h = container.clientHeight || 380;

      threeScene = new THREE.Scene();
      const isNight = state.onlineTrack === 'night';
      threeScene.background = new THREE.Color(isNight ? 0x050816 : 0x0a1c14);
      threeScene.fog = new THREE.Fog(isNight ? 0x050816 : 0x0a1c14, 22, 95);

      threeCamera = new THREE.PerspectiveCamera(62, w / h, 0.1, 140);
      threeCamera.position.set(0, 4.8, 7.5);
      threeCamera.lookAt(0, 0.8, -12);

      threeRenderer = new THREE.WebGLRenderer({ antialias: true });
      threeRenderer.setSize(w, h);
      threeRenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      container.appendChild(threeRenderer.domElement);

      const amb = new THREE.AmbientLight(0xffffff, 0.72);
      threeScene.add(amb);
      const dir = new THREE.DirectionalLight(0xffffff, 0.9);
      dir.position.set(8, 18, 12);
      threeScene.add(dir);

      // Road plane
      const roadGeo = new THREE.PlaneGeometry(14, 220);
      const roadMat = new THREE.MeshLambertMaterial({ color: 0x1e293b });
      const road = new THREE.Mesh(roadGeo, roadMat);
      road.rotation.x = -Math.PI / 2;
      road.position.z = -80;
      threeScene.add(road);

      // Neon side rails
      const railGeo = new THREE.BoxGeometry(0.35, 0.4, 220);
      const railMat = new THREE.MeshBasicMaterial({ color: isNight ? 0x38bdf8 : 0xf59e0b });
      [-7.1, 7.1].forEach((rx) => {
        const rail = new THREE.Mesh(railGeo, railMat);
        rail.position.set(rx, 0.2, -80);
        threeScene.add(rail);
      });

      // Dashed lane markers
      threeRoadLines = [];
      const dashGeo = new THREE.BoxGeometry(0.18, 0.04, 3.2);
      const dashMat = new THREE.MeshBasicMaterial({ color: 0x94a3b8 });
      for (let z = 10; z > -160; z -= 8) {
        [-2.35, 2.35].forEach((lx) => {
          const d = new THREE.Mesh(dashGeo, dashMat);
          d.position.set(lx, 0.03, z);
          threeScene.add(d);
          threeRoadLines.push(d);
        });
      }

      // Finish arch (moves into view near end)
      threeFinishArch = new THREE.Group();
      const postGeo = new THREE.BoxGeometry(0.6, 5.5, 0.6);
      const postMat = new THREE.MeshPhongMaterial({ color: 0xfacc15 });
      const p1 = new THREE.Mesh(postGeo, postMat); p1.position.set(-7, 2.75, 0);
      const p2 = new THREE.Mesh(postGeo, postMat); p2.position.set(7, 2.75, 0);
      const topBar = new THREE.Mesh(new THREE.BoxGeometry(14.6, 1.1, 0.7), new THREE.MeshBasicMaterial({ color: 0xef4444 }));
      topBar.position.set(0, 5.2, 0);
      threeFinishArch.add(p1, p2, topBar);
      threeFinishArch.position.set(0, 0, -200);
      threeScene.add(threeFinishArch);

      threeCars = racers.map((r) => {
        const colorNum = parseInt(r.color.replace('#', ''), 16);
        const mesh = build3DCarMesh(colorNum, r.isMe);
        threeScene.add(mesh);
        return { racer: r, mesh };
      });
      threePads = [];
      threeBarriers = [];
    }

    function startOnlineRace() {
      stopCurrentGameLoop();
      document.getElementById('online-lobby-wrapper').classList.add('hidden');
      document.getElementById('canvas-wrapper').classList.remove('hidden');
      document.getElementById('game-canvas').classList.add('hidden');
      document.getElementById('three-race-container').classList.remove('hidden');
      document.getElementById('online-race-hud').classList.remove('hidden');
      overlay.classList.add('hidden');

      const lvlCfg = RACE_LEVELS[selectedRaceLevel - 1];
      document.getElementById('or-hud-level').textContent = `${selectedRaceLevel}/10`;
      const totalRacers = lobbyRacers.length;
      const racers = lobbyRacers.map((r, idx) => ({
        ...r,
        xNorm: 0.18 + (idx / Math.max(1, totalRacers - 1)) * 0.64,
        dist: 0,
        speed: r.isMe ? 54 : (lvlCfg.aiSpeed - 4 + Math.random() * 8),
        targetX: 0.2 + Math.random() * 0.6,
        aiTimer: 0.5 + Math.random()
      }));

      orState = {
        lvlCfg,
        lastTime: performance.now(),
        nitroActive: false,
        nitroFuel: 100,
        padTimer: 1.1,
        trafficTimer: lvlCfg.trafficRate,
        racers
      };

      if (window.THREE) {
        initThreeRaceScene(lvlCfg, racers);
      }
      gameRunning = true;
      playTone(520, 0.12, 'triangle', 0.08);
      rafId = requestAnimationFrame(onlineRaceLoop);
    }

    function steerOnline(dir) {
      if (!gameRunning || activeGame !== 'online_race' || !orState) return;
      const me = orState.racers.find(r => r.isMe);
      if (me) me.xNorm = Math.max(0.1, Math.min(0.9, me.xNorm + dir * 0.14));
      playTone(300, 0.04, 'sine', 0.04);
    }
    function activateOnlineNitro() {
      if (!gameRunning || activeGame !== 'online_race' || !orState) return;
      if (orState.nitroFuel >= 15) { orState.nitroActive = true; playTone(740, 0.14, 'sawtooth', 0.07); }
    }
    document.getElementById('or-left').addEventListener('click', () => steerOnline(-1));
    document.getElementById('or-right').addEventListener('click', () => steerOnline(1));
    document.getElementById('or-nitro-btn').addEventListener('click', activateOnlineNitro);

    function onlineRaceLoop(now) {
      if (!gameRunning || activeGame !== 'online_race' || !orState) return;
      const dt = Math.min(0.05, (now - orState.lastTime) / 1000);
      orState.lastTime = now;
      const me = orState.racers.find(r => r.isMe);
      const lvlCfg = orState.lvlCfg;

      if (orState.nitroActive) {
        orState.nitroFuel = Math.max(0, orState.nitroFuel - dt * 42);
        me.speed = Math.max(me.speed, lvlCfg.aiSpeed + 32);
        if (orState.nitroFuel <= 0) orState.nitroActive = false;
      } else {
        orState.nitroFuel = Math.min(100, orState.nitroFuel + dt * 14);
        me.speed = Math.max(lvlCfg.aiSpeed + 4, me.speed - dt * 22);
      }

      orState.racers.forEach((r) => {
        if (!r.isMe) {
          r.aiTimer -= dt;
          if (r.aiTimer <= 0) {
            r.aiTimer = 0.7 + Math.random() * 1.1;
            r.targetX = 0.14 + Math.random() * 0.72;
            r.speed = lvlCfg.aiSpeed - 3 + Math.random() * 12;
          }
          r.xNorm += (r.targetX - r.xNorm) * dt * 2.8;
        }
        r.dist += r.speed * dt;
      });

      if (threeScene && threeRenderer && threeCamera) {
        // Animate road dashes
        threeRoadLines.forEach((d) => {
          d.position.z += me.speed * 0.65 * dt;
          if (d.position.z > 12) d.position.z -= 168;
        });

        // Spawn 3D Boost Pads
        orState.padTimer -= dt;
        if (orState.padTimer <= 0) {
          orState.padTimer = 1.6;
          const padMesh = new THREE.Mesh(new THREE.BoxGeometry(1.6, 0.12, 2.2), new THREE.MeshBasicMaterial({ color: 0x10b981 }));
          const xNorm = 0.16 + Math.random() * 0.68;
          padMesh.position.set((xNorm - 0.5) * 11, 0.08, -95);
          threeScene.add(padMesh);
          threePads.push({ mesh: padMesh, xNorm });
        }

        // Spawn 3D Barriers
        orState.trafficTimer -= dt;
        if (orState.trafficTimer <= 0) {
          orState.trafficTimer = lvlCfg.trafficRate;
          const barMesh = new THREE.Mesh(new THREE.BoxGeometry(1.6, 0.9, 0.9), new THREE.MeshPhongMaterial({ color: 0xf97316 }));
          const xNorm = 0.14 + Math.random() * 0.72;
          barMesh.position.set((xNorm - 0.5) * 11, 0.45, -95);
          threeScene.add(barMesh);
          threeBarriers.push({ mesh: barMesh, xNorm });
        }

        for (let i = threePads.length - 1; i >= 0; i--) {
          const p = threePads[i];
          p.mesh.position.z += me.speed * 0.65 * dt;
          if (Math.abs(p.mesh.position.z) < 2.2 && Math.abs(p.xNorm - me.xNorm) < 0.14) {
            me.speed = lvlCfg.aiSpeed + 36;
            orState.nitroFuel = Math.min(100, orState.nitroFuel + 30);
            playCoinSound();
            threeScene.remove(p.mesh);
            threePads.splice(i, 1);
            continue;
          }
          if (p.mesh.position.z > 12) { threeScene.remove(p.mesh); threePads.splice(i, 1); }
        }

        for (let i = threeBarriers.length - 1; i >= 0; i--) {
          const b = threeBarriers[i];
          b.mesh.position.z += me.speed * 0.62 * dt;
          if (Math.abs(b.mesh.position.z) < 2.1 && Math.abs(b.xNorm - me.xNorm) < 0.13) {
            me.speed = Math.max(24, me.speed - 24);
            orState.nitroActive = false;
            playCrashSound();
            threeScene.remove(b.mesh);
            threeBarriers.splice(i, 1);
            continue;
          }
          if (b.mesh.position.z > 12) { threeScene.remove(b.mesh); threeBarriers.splice(i, 1); }
        }

        // Update 3D cars positions relative to player
        threeCars.forEach(({ racer, mesh }) => {
          const worldX = (racer.xNorm - 0.5) * 11;
          const relZ = -(racer.dist - me.dist) * 0.65;
          mesh.position.set(worldX, 0, relZ);
          if (mesh.userData.flame) {
            mesh.userData.flame.visible = racer.isMe && orState.nitroActive;
          }
        });

        // Move finish arch
        const distLeft = lvlCfg.dist - me.dist;
        threeFinishArch.position.z = -distLeft * 0.65;

        // Smooth camera follow
        const targetCamX = (me.xNorm - 0.5) * 6.5;
        threeCamera.position.x += (targetCamX - threeCamera.position.x) * dt * 6;
        threeCamera.fov = orState.nitroActive ? 68 : 62;
        threeCamera.updateProjectionMatrix();
        threeRenderer.render(threeScene, threeCamera);
      }

      const sorted = [...orState.racers].sort((a, b) => b.dist - a.dist);
      const myPlace = sorted.findIndex(r => r.isMe) + 1;
      const pct = Math.min(100, Math.floor((me.dist / lvlCfg.dist) * 100));
      document.getElementById('game-hud-timer').textContent = `${pct}%`;
      document.getElementById('or-place').textContent = `${myPlace} / ${orState.racers.length}`;
      document.getElementById('or-speed').textContent = `${Math.round(me.speed * 2.8)} км/ч`;
      document.getElementById('or-nitro').textContent = `${Math.round(orState.nitroFuel)}%`;

      if (me.dist >= lvlCfg.dist) {
        stopCurrentGameLoop();
        const prize = myPlace === 1 ? lvlCfg.reward1 : myPlace === 2 ? Math.round(lvlCfg.reward1 * 0.6) : 5;
        if (myPlace <= 2) {
          const comp = state.raceCompletedLevels || [];
          if (!comp.includes(selectedRaceLevel)) { comp.push(selectedRaceLevel); state.raceCompletedLevels = comp; }
          if (selectedRaceLevel >= (state.raceUnlockedLevel || 1) && selectedRaceLevel < 10) state.raceUnlockedLevel = selectedRaceLevel + 1;
        }
        recordCompletedRun(`Гонки 3D Ур.${selectedRaceLevel} (${myPlace} место)`, prize);
        if (myPlace === 1) advanceQuest('winRace1', 1);
        document.getElementById('active-game-subtitle').textContent = `Заездов сегодня: ${Math.min(state.dailyRuns, 3)}/3`;
        showOverlay(myPlace === 1 ? '🥇' : '🏁', `Финиш! ${myPlace} место (Ур. ${selectedRaceLevel})`, `Награда +${prize} 🪙 начислена на баланс!`, 'В лобби (следующий ур.)');
        document.getElementById('game-start-btn').onclick = () => { document.getElementById('game-start-btn').onclick = null; openGame('online_race'); };
        return;
      }
      rafId = requestAnimationFrame(onlineRaceLoop);
    }

    // ---------- MATCH-3 ----------
    const M3_GEMS = ['💎', '🔥', '⚡', '🍀', '🌟'];
    let m3Grid = [], m3Selected = null, m3Score = 0, m3Moves = 12;
    function initMatch3(forceReset = false) {
      if (!forceReset && state.match3Progress && state.match3Progress.moves > 0) {
        m3Grid = state.match3Progress.grid; m3Score = state.match3Progress.score; m3Moves = state.match3Progress.moves; m3Selected = null; renderMatch3(); return;
      }
      m3Score = 0; m3Moves = 12; m3Selected = null;
      m3Grid = Array.from({ length: 6 }, () => Array.from({ length: 6 }, () => M3_GEMS[Math.floor(Math.random() * M3_GEMS.length)]));
      clearM3Matches(false); state.match3Progress = { grid: m3Grid, score: m3Score, moves: m3Moves }; saveState(); renderMatch3();
    }
    function findM3Matches() {
      const matched = new Set();
      for (let r = 0; r < 6; r++) for (let c = 0; c < 4; c++) { const g = m3Grid[r][c]; if (g && g === m3Grid[r][c + 1] && g === m3Grid[r][c + 2]) { matched.add(`${r},${c}`); matched.add(`${r},${c + 1}`); matched.add(`${r},${c + 2}`); } }
      for (let c = 0; c < 6; c++) for (let r = 0; r < 4; r++) { const g = m3Grid[r][c]; if (g && g === m3Grid[r + 1][c] && g === m3Grid[r + 2][c]) { matched.add(`${r},${c}`); matched.add(`${r + 1},${c}`); matched.add(`${r + 2},${c}`); } }
      return matched;
    }
    function clearM3Matches(addScore = true) {
      for (let l = 0; l < 10; l++) {
        const matched = findM3Matches(); if (matched.size === 0) break;
        if (addScore) m3Score += matched.size * 10;
        matched.forEach((k) => { const [r, c] = k.split(',').map(Number); m3Grid[r][c] = null; });
        for (let c = 0; c < 6; c++) {
          let w = 5;
          for (let r = 5; r >= 0; r--) if (m3Grid[r][c] !== null) { m3Grid[w][c] = m3Grid[r][c]; if (w !== r) m3Grid[r][c] = null; w--; }
          for (let r = w; r >= 0; r--) m3Grid[r][c] = M3_GEMS[Math.floor(Math.random() * M3_GEMS.length)];
        }
      }
    }
    function renderMatch3() {
      document.getElementById('m3-score').textContent = m3Score; document.getElementById('m3-moves').textContent = m3Moves;
      const board = document.getElementById('m3-board'); board.innerHTML = '';
      for (let r = 0; r < 6; r++) for (let c = 0; c < 6; c++) {
        const btn = document.createElement('button'); btn.type = 'button';
        const isSel = m3Selected && m3Selected.r === r && m3Selected.c === c;
        btn.className = `aspect-square rounded-xl text-2xl flex items-center justify-center border transition-all ${isSel ? 'bg-pink-500/30 border-pink-400 scale-105' : 'bg-slate-950 border-white/10 hover:border-white/25'}`;
        btn.textContent = m3Grid[r][c]; btn.addEventListener('click', () => handleM3Click(r, c)); board.appendChild(btn);
      }
    }
    function handleM3Click(r, c) {
      if (m3Moves <= 0) return;
      if (!m3Selected) { m3Selected = { r, c }; playTone(400, 0.04, 'sine', 0.05); renderMatch3(); return; }
      if (Math.abs(m3Selected.r - r) + Math.abs(m3Selected.c - c) !== 1) { m3Selected = { r, c }; renderMatch3(); return; }
      const tmp = m3Grid[m3Selected.r][m3Selected.c]; m3Grid[m3Selected.r][m3Selected.c] = m3Grid[r][c]; m3Grid[r][c] = tmp;
      if (findM3Matches().size === 0) { m3Grid[r][c] = m3Grid[m3Selected.r][m3Selected.c]; m3Grid[m3Selected.r][m3Selected.c] = tmp; m3Selected = null; playCrashSound(); renderMatch3(); return; }
      m3Selected = null; m3Moves -= 1; clearM3Matches(true); state.match3Progress = { grid: m3Grid, score: m3Score, moves: m3Moves }; saveState(); playCoinSound(); renderMatch3();
      if (m3Score >= 120) { m3Moves = 0; state.match3Progress = null; recordCompletedRun('3 в ряд', 5); advanceQuest('match3Win', 1); setTimeout(() => initMatch3(true), 1600); }
      else if (m3Moves <= 0) { state.match3Progress = null; saveState(); showToast('Ходы закончились!', 'warn'); setTimeout(() => initMatch3(true), 1400); }
    }

    // ---------- DRIFT / TURBO / ASTRO ----------
    function startCanvasGame(type) {
      stopCurrentGameLoop(); overlay.classList.add('hidden'); resizeCanvas(); gameRunning = true;
      const now = performance.now(), dur = GAME_META[type].duration;
      if (type === 'drift') gameState = { lane: 1, obstacles: [], spawnTimer: 0, roadOffset: 0, timeLeft: dur, lastTime: now };
      else if (type === 'astro') gameState = { lane: 1, obstacles: [], stars: Array.from({ length: 35 }, () => ({ x: Math.random() * canvas.width, y: Math.random() * canvas.height, s: 1 + Math.random() * 2 })), spawnTimer: 0, timeLeft: dur, lastTime: now };
      else if (type === 'turbo') gameState = { playerPos: 0, rivalPos: 0, needle: 0, needleDir: 1, speedBoost: 0, timeLeft: dur, lastTime: now };
      playTone(440, 0.08, 'sine', 0.07); rafId = requestAnimationFrame(gameLoop);
    }
    function moveLane(dir) { if (gameRunning && (activeGame === 'drift' || activeGame === 'astro')) { gameState.lane = Math.max(0, Math.min(2, gameState.lane + dir)); playTone(320, 0.05, 'triangle', 0.05); } }
    function triggerTurboBoost() {
      if (!gameRunning || activeGame !== 'turbo') return;
      if (gameState.needle >= 55 && gameState.needle <= 82) { gameState.speedBoost = 24; gameState.playerPos = Math.min(100, gameState.playerPos + 14); playTone(760, 0.1, 'triangle', 0.09); }
      else { gameState.playerPos = Math.min(100, gameState.playerPos + 4); playTone(220, 0.07, 'sine', 0.05); }
    }
    document.getElementById('ctrl-left').addEventListener('click', () => moveLane(-1));
    document.getElementById('ctrl-right').addEventListener('click', () => moveLane(1));
    document.getElementById('ctrl-boost').addEventListener('click', triggerTurboBoost);
    window.addEventListener('keydown', (e) => {
      if (!gameRunning) return;
      if (activeGame === 'online_race') {
        if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') steerOnline(-1);
        if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') steerOnline(1);
        if (e.key === ' ') { e.preventDefault(); activateOnlineNitro(); }
      } else {
        if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') moveLane(-1);
        if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') moveLane(1);
        if (e.key === ' ' && activeGame === 'turbo') { e.preventDefault(); triggerTurboBoost(); }
      }
    });

    function finishRunSuccess() {
      stopCurrentGameLoop(); recordCompletedRun(GAME_META[activeGame].title);
      document.getElementById('active-game-subtitle').textContent = `Заездов сегодня: ${Math.min(state.dailyRuns, 3)}/3`;
      showOverlay('🏆', 'Финиш! Заезд засчитан', state.dailyClaimed && state.dailyRuns === 3 ? 'Награда +10 🪙 зачислена!' : `Заезд засчитан (${Math.min(state.dailyRuns, 3)}/3).`, 'Ещё заезд');
    }
    function finishRunCrash() { stopCurrentGameLoop(); playCrashSound(); showOverlay('💥', 'Столкновение!', 'Попробуй ещё раз.', 'Повторить заезд'); }

    function gameLoop(now) {
      if (!gameRunning) return;
      const dt = Math.min(0.05, (now - gameState.lastTime) / 1000); gameState.lastTime = now;
      if (activeGame === 'drift' || activeGame === 'astro') {
        gameState.timeLeft = Math.max(0, gameState.timeLeft - dt);
        document.getElementById('game-hud-timer').textContent = `${gameState.timeLeft.toFixed(1)}s`;
        if (gameState.timeLeft <= 0) { finishRunSuccess(); return; }
        const w = canvas.width, h = canvas.height, laneW = Math.min(110, (w - 40) / 3), roadW = laneW * 3, roadX = (w - roadW) / 2;
        if (activeGame === 'drift') {
          ctx.fillStyle = '#0b1120'; ctx.fillRect(0, 0, w, h); ctx.fillStyle = '#1e293b'; ctx.fillRect(roadX, 0, roadW, h);
          gameState.roadOffset = (gameState.roadOffset + dt * 360) % 48;
          ctx.strokeStyle = 'rgba(56, 189, 248, 0.45)'; ctx.lineWidth = 3; ctx.setLineDash([24, 24]); ctx.lineDashOffset = -gameState.roadOffset;
          for (let i = 1; i <= 2; i++) { ctx.beginPath(); ctx.moveTo(roadX + laneW * i, 0); ctx.lineTo(roadX + laneW * i, h); ctx.stroke(); }
          ctx.setLineDash([]);
        } else {
          ctx.fillStyle = '#060312'; ctx.fillRect(0, 0, w, h); ctx.fillStyle = 'rgba(255,255,255,0.7)';
          gameState.stars.forEach((st) => { st.y += dt * 180; if (st.y > h) { st.y = 0; st.x = Math.random() * w; } ctx.fillRect(st.x, st.y, st.s, st.s); });
        }
        gameState.spawnTimer -= dt; if (gameState.spawnTimer <= 0) { gameState.spawnTimer = 0.72; gameState.obstacles.push({ lane: Math.floor(Math.random() * 3), y: -40 }); }
        const playerX = roadX + gameState.lane * laneW + laneW / 2, playerY = h - 64;
        for (let i = gameState.obstacles.length - 1; i >= 0; i--) {
          const ob = gameState.obstacles[i]; ob.y += dt * 310; const ox = roadX + ob.lane * laneW + laneW / 2;
          ctx.font = '32px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(activeGame === 'drift' ? '🚧' : '☄️', ox, ob.y);
          if (ob.lane === gameState.lane && Math.abs(ob.y - playerY) < 34) { finishRunCrash(); return; }
          if (ob.y > h + 40) gameState.obstacles.splice(i, 1);
        }
        if (activeGame === 'drift') drawSportCar(playerX, playerY, '#38bdf8', true, false);
        else { ctx.font = '38px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText('🚀', playerX, playerY); }
      } else if (activeGame === 'turbo') {
        gameState.timeLeft = Math.max(0, gameState.timeLeft - dt);
        document.getElementById('game-hud-timer').textContent = `${gameState.timeLeft.toFixed(1)}s`;
        gameState.needle += gameState.needleDir * dt * 120; if (gameState.needle >= 100) { gameState.needle = 100; gameState.needleDir = -1; } if (gameState.needle <= 0) { gameState.needle = 0; gameState.needleDir = 1; }
        gameState.speedBoost = Math.max(0, gameState.speedBoost - dt * 30); gameState.playerPos = Math.min(100, gameState.playerPos + dt * (3 + gameState.speedBoost * 0.4)); gameState.rivalPos = Math.min(96, gameState.rivalPos + dt * 7.2);
        const w = canvas.width, h = canvas.height, pad = 28, trackW = w - pad * 2;
        ctx.fillStyle = '#091518'; ctx.fillRect(0, 0, w, h); ctx.fillStyle = '#1e293b'; ctx.fillRect(pad, 90, trackW, 46); ctx.fillRect(pad, 165, trackW, 46);
        ctx.fillStyle = '#facc15'; ctx.fillRect(pad + trackW - 8, 82, 6, 138);
        ctx.font = '28px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText('🏎️', pad + (trackW - 24) * (gameState.playerPos / 100) + 12, 113); ctx.fillText('🚙', pad + (trackW - 24) * (gameState.rivalPos / 100) + 12, 188);
        ctx.fillStyle = '#94a3b8'; ctx.font = 'bold 12px Inter, sans-serif'; ctx.textAlign = 'left'; ctx.fillText('ТЫ', pad, 78); ctx.fillText('СОПЕРНИК', pad, 153);
        const barY = h - 90; ctx.fillStyle = '#1e293b'; ctx.fillRect(pad, barY, trackW, 28); ctx.fillStyle = '#10b981'; ctx.fillRect(pad + trackW * 0.55, barY, trackW * 0.27, 28); ctx.fillStyle = '#ffffff'; ctx.fillRect(pad + trackW * (gameState.needle / 100) - 3, barY - 6, 6, 40);
        if (gameState.playerPos >= 100) { finishRunSuccess(); return; } if (gameState.timeLeft <= 0) { finishRunCrash(); return; }
      }
      rafId = requestAnimationFrame(gameLoop);
    }

    // Export / Import Save
    document.getElementById('export-save-btn').addEventListener('click', () => {
      saveState();
      const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = `zoocloc_save_${Date.now()}.json`;
      document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
      showToast('Файл сохранения скачан!', 'success');
    });
    document.getElementById('import-save-input').addEventListener('change', (e) => {
      const file = e.target.files && e.target.files[0]; if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        try {
          const parsed = JSON.parse(reader.result);
          if (typeof parsed !== 'object' || parsed === null || typeof parsed.balance !== 'number') { showToast('Неверный формат файла!', 'warn'); return; }
          state = { ...cloneDefault(), ...parsed, profile: { ...defaultState.profile, ...(parsed.profile || {}) }, adminProfile: { ...defaultState.adminProfile, ...(parsed.adminProfile || {}) } };
          saveState(); renderAll(); playCoinSound(); showToast('Игровой прогресс восстановлен!', 'success');
        } catch (err) { showToast('Не удалось прочитать файл.', 'warn'); }
      };
      reader.readAsText(file);
    });

    // Init & Loading Screen
    window.addEventListener('load', () => {
      state = loadState();
      const startTab = state.currentTab && (state.currentTab !== 'admin' || state.isAdmin) ? state.currentTab : 'games';
      switchTab(startTab);
      const screen = document.getElementById('loading-screen'), bar = document.getElementById('loading-progress-bar'), statusEl = document.getElementById('loading-status-text'), summaryEl = document.getElementById('loading-summary-pill');
      if (!screen) return;
      summaryEl.textContent = `Профиль: ${getActiveProfile().username} • Баланс: ${state.balance} 🪙 • Ур. гонок: ${state.raceCompletedLevels.length}/10 • Загадки: ${state.riddleSolvedLevels.length}/150`;
      setTimeout(() => { bar.style.width = '55%'; statusEl.textContent = 'Восстанавливаем уровни и баланс...'; }, 250);
      setTimeout(() => { bar.style.width = '100%'; statusEl.textContent = 'Готово! Всё сохранение загружено.'; }, 650);
      setTimeout(() => { screen.style.opacity = '0'; screen.style.pointerEvents = 'none'; setTimeout(() => screen.classList.add('hidden'), 480); }, 950);
    });
  </script>
</body>
</html>
